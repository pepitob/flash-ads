---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnswerBlock from "../../components/AnswerBlock.astro";
import PricingGrid from "../../components/PricingGrid.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import GooglePartnerBadge from "../../components/GooglePartnerBadge.astro";
import FAQ from "../../components/FAQ.astro";
import CTA from "../../components/CTA.astro";
import { ui } from "../../i18n/fr";
import { serviceSchema, breadcrumbSchema, type FaqItem } from "../../lib/schema";

const title = "Gestion de campagnes Google Ads en Suisse romande | Flash Ads";
const description =
  "Flash Ads gère vos campagnes Google Ads pour vous amener plus de clients : packs fixes et publics dès 390.-/mois, 0% de commission sur votre budget. Google Partner en Suisse romande.";
const path = "/services/google-ads";

const faqItems: FaqItem[] = [
  {
    question: "Concrètement, que faites-vous ?",
    answer:
      "On crée et on gère vos publicités sur Google : celles qui s'affichent quand quelqu'un cherche votre produit ou service. On choisit les bons mots, on écrit les annonces, on suit les résultats et on améliore tout ça mois après mois, pour vous amener plus de demandes de clients.",
  },
  {
    question: "Combien coûte la publicité sur Google ?",
    answer:
      "Il y a deux montants distincts. D'abord votre budget publicitaire, versé directement à Google avec votre carte (500 CHF/mois minimum pour que ça vaille la peine). Ensuite nos frais de gestion, fixes et affichés : de 390.- à 1190.- par mois selon votre budget, sur mesure au-delà de 15 000.- de budget. On ne prend aucune commission sur ce que vous dépensez chez Google.",
  },
  {
    question: "Que veut dire Search, Display et Shopping ?",
    answer:
      "Search : vos annonces apparaissent dans les résultats de recherche Google quand quelqu'un cherche vos services (« plombier Sion », « dentiste Lausanne ») : le canal le plus direct, la personne cherche déjà ce que vous offrez. Display : des bannières visuelles diffusées sur des sites et applications partenaires de Google, utiles pour la notoriété et pour rappeler votre marque aux visiteurs de votre site. Shopping : vos produits apparaissent avec photo et prix directement dans Google, réservé aux e-commerces, avec un catalogue produits (d'où le setup Shopping). Il existe aussi Performance Max (PMax), un format automatisé de Google qui diffuse sur tous les canaux à la fois, utilisable dès le pack Croissance.",
  },
  {
    question: "Comment mon pack est-il déterminé ?",
    answer:
      "Uniquement par votre budget publicitaire mensuel : de 500 à 1200.- c'est Starter, de 1200 à 5000.- Croissance, de 5000 à 15000.- Performance, et au-delà sur mesure. Pas de grille par secteur, par taille d'entreprise ou par nombre de mots-clés. Et si votre budget évolue, le changement de pack se fait au mois suivant, sans frais.",
  },
  {
    question: "Pourquoi refusez-vous les budgets sous 500.- par mois ?",
    answer:
      "Parce qu'en dessous de ce seuil, les campagnes ne génèrent pas assez de données pour être optimisées : les résultats sont aléatoires et vous paieriez des frais de gestion pour rien. Plutôt que d'encaisser en sachant que ça ne marchera pas, on préfère vous le dire d'entrée. Mieux vaut attendre d'avoir le budget que de tester trop petit.",
  },
  {
    question: "Pourquoi le setup tracking est-il obligatoire ?",
    answer:
      "Sans suivi des conversions, impossible de savoir quelles annonces génèrent des appels, des formulaires ou des ventes, donc impossible d'optimiser. Gérer des campagnes sans tracking, c'est piloter à l'aveugle, et on refuse de le faire. Les 300.- couvrent l'installation complète sur WordPress : appels, clics e-mail, formulaires et actions clés. Les intégrations CRM font l'objet d'une option dédiée.",
  },
  {
    question: "Que sont les 2 canaux au choix du pack Croissance ?",
    answer:
      "Deux canaux définis ensemble au setup, selon votre activité : par exemple Search + Shopping pour un e-commerce, ou Search + Display pour une entreprise de services. Aucune combinaison imposée : on choisit ce qui rapporte le plus pour vous.",
  },
  {
    question: "Qu'est-ce qu'une campagne spéciale ?",
    answer:
      "Une campagne ou un ajustement ponctuel lié à un événement : soldes, Black Friday, saison haute, lancement d'une promotion. C'est inclus selon votre pack (1, 3 ou 5 par an). Au-delà du quota, c'est facturable en supplément.",
  },
  {
    question: "Qu'est-ce que la connexion CRM / enhanced conversions ?",
    answer:
      "On relie votre CRM (ou vos données de vente) à Google Ads, pour que l'algorithme sache quels clics deviennent de vrais clients, pas seulement des formulaires remplis. Résultat : un ciblage qui s'améliore et un budget qui va vers ce qui rapporte vraiment. Incluse dans le pack Performance, en option à +200.-/mois sur Starter et Croissance.",
  },
  {
    question: "Travaillez-vous avec mon compte Google existant ?",
    answer:
      "Oui. On peut reprendre votre compte actuel ou en créer un nouveau si besoin. Dans tous les cas, le compte vous appartient : vous gardez la main, et son historique aussi.",
  },
  {
    question: "Faut-il signer un long contrat ?",
    answer:
      "Non, juste un engagement initial de 3 mois, le temps que Google Ads accumule 6 à 8 semaines de données et que l'optimisation devienne fiable. Ensuite, vous pouvez résilier chaque mois, sans pénalité. Vous restez parce que ça marche, pas parce qu'un contrat vous retient.",
  },
];

const jsonLd = [
  serviceSchema({
    name: "Gestion de publicités Google Ads",
    description,
    url: path,
    serviceType: "Publicité en ligne (Google Ads)",
    withPricing: true, // offres tarifaires (émises seulement si pricingValidated)
  }),
  breadcrumbSchema([
    { name: "Accueil", url: "/" },
    { name: "Services", url: path },
    { name: "Publicité Google", url: path },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="page-hero band band--blue">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a> <span aria-hidden="true">/</span> <span>Publicité Google</span>
      </nav>
      <span class="eyebrow">Publicité sur Google</span>
      <h1 class="display">Vos annonces sur Google, <span class="flash-word">sans commission</span> sur votre budget.</h1>

      <AnswerBlock>
        <p>
          <b>Flash Ads s'occupe de vos publicités sur Google</b> pour les PME en Suisse romande : on
          crée vos annonces, on choisit les bons mots et on améliore tout en continu pour vous amener
          plus de clients. Vous payez un <b>montant fixe chaque mois</b>, de 390.- à 1190.- selon
          votre budget publicitaire. Aucune commission sur votre budget de pub, que vous versez
          directement à Google. Le pack se choisit sur un seul critère : votre budget mensuel.
        </p>
      </AnswerBlock>

      <div class="hero-cta">
        <a href="/contact" class="btn btn-primary">{ui.cta.quote} <span class="arrow" aria-hidden="true">→</span></a>
        <a href="#tarifs" class="btn btn-ghost">{ui.cta.seePricing}</a>
      </div>
      <div class="hero-badge"><GooglePartnerBadge height={56} /><span class="mono">Agence certifiée Google Partner</span></div>
    </div>
  </section>

  <!-- BÉNÉFICES -->
  <section class="band band--paper">
    <div class="wrap">
      <SectionHead
        eyebrow="Ce que vous y gagnez"
        title="Des demandes de clients, pas juste des clics."
        text="On pilote vos campagnes sur ce qui compte vraiment : combien de clients ça vous amène, et à quel prix."
      />
      <div class="cards3">
        <div class="card">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M3 17l6-6 4 4 8-8" /><path d="M21 7v6h-6" /></svg></div>
          <h3>Plus de demandes</h3>
          <p>Vos annonces apparaissent au moment exact où les gens cherchent ce que vous proposez. Vous touchez des personnes vraiment intéressées.</p>
        </div>
        <div class="card">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" /></svg></div>
          <h3>Un coût maîtrisé</h3>
          <p>On surveille combien vous coûte chaque nouvelle demande, et on coupe ce qui ne rapporte pas. Votre argent va là où il fait venir des clients.</p>
        </div>
        <div class="card">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></svg></div>
          <h3>Tout est clair</h3>
          <p>Rapports simples, accès à votre compte, prix affiché. Vous savez ce qu'on fait, ce que ça coûte, et ce que ça vous rapporte.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMMENT ON FAIT -->
  <section class="process band band--tint">
    <div class="wrap process-grid">
      <div>
        <span class="eyebrow">Comment on fait</span>
        <h2 class="display">On regarde, on installe, on lance, on améliore.</h2>
        <p class="muted">
          Chaque client suit le même déroulé clair : on regarde ce qui existe, on installe de quoi
          mesurer les résultats, on crée vos annonces, puis on améliore en continu. Le détail complet
          est sur la page Agence.
        </p>
        <a href="/agence#methode" class="btn btn-ghost process-link">{ui.cta.discoverAgency} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="proc-list">
        <li><span class="mono no">01</span> On regarde votre situation, gratuitement</li>
        <li><span class="mono no">02</span> On installe de quoi voir ce qui marche</li>
        <li><span class="mono no">03</span> On crée et on lance vos annonces</li>
        <li><span class="mono no">04</span> On améliore en continu, avec un rapport clair</li>
      </ul>
    </div>
  </section>

  <!-- TARIFS -->
  <section id="tarifs" class="band band--paper">
    <div class="wrap">
      <SectionHead
        eyebrow="Nos prix"
        title="Quatre packs, un prix fixe et affiché."
        text="Choisissez selon votre budget publicitaire mensuel : c'est le seul critère. 0% de commission sur votre budget."
      />
      <PricingGrid ctaHref="/contact" />
      <p class="pricing-tool">
        Pour savoir dans quel pack vous tombez, commencez par estimer votre budget publicitaire avec
        notre <a href="/calculateur-budget">calculateur de budget Google Ads</a>.
      </p>
    </div>
  </section>

  <!-- RÉSULTATS CLIENTS -->
  <section class="band band--night">
    <div class="wrap">
      <SectionHead
        eyebrow="Résultats clients"
        title="Ce qu'on a obtenu pour des PME romandes."
        text="Résultats mesurés sur le compte du client, tracking des conversions en place avant et après."
      />
      <div class="cases">
        <CaseStudyCard
          metric="+63%"
          who="Chauffage sanitaire · Valais"
          context="Annonces dispersées : le budget partait sur des recherches trop larges, sans intention d'achat."
          action="On a resserré les campagnes sur les recherches de dépannage et écarté ce qui ne rapportait rien."
        >
          Deux tiers de demandes de devis en plus en six mois, à budget publicitaire constant.
        </CaseStudyCard>
        <CaseStudyCard
          metric="−29%"
          who="Cabinet dentaire · Lausanne"
          context="Chaque nouveau patient coûtait cher, et le compte ne mesurait ni les appels ni les prises de rendez-vous."
          action="On a remis le suivi des conversions d'aplomb, puis réécrit les annonces autour des soins recherchés."
        >
          Chaque nouveau patient coûte près d'un tiers de moins qu'avant, en trois mois.
        </CaseStudyCard>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ items={faqItems} title="Vos questions sur la publicité Google" eyebrow="FAQ · Publicité Google" />

  <CTA
    title="On regarde votre situation, gratuitement ?"
    text="On vous dit franchement si la pub Google peut vous amener des clients, et combien ça coûterait. Sans jargon, prix publics."
  />
</BaseLayout>

<style>
  .pricing-tool { font-size: 14px; color: var(--muted-on, var(--muted)); text-align: center; margin-top: 22px; }
  .pricing-tool a { color: var(--accent-on, var(--accent)); text-decoration: none; font-weight: 500; }
  .pricing-tool a:hover { text-decoration: underline; }
  .page-hero { padding: 72px 0 20px; }
  .crumbs { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-on, var(--muted)); margin-bottom: 22px; }
  .crumbs a { text-decoration: none; color: var(--muted-on, var(--muted)); }
  .crumbs a:hover { color: var(--accent-on, var(--accent)); }
  .page-hero h1 { font-size: clamp(34px, 4.6vw, 56px); font-weight: 600; margin: 18px 0 22px; max-width: 16em; }
  .hero-cta { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
  .hero-badge { display: flex; align-items: center; gap: 14px; margin-top: 28px; }
  .hero-badge .mono { font-size: 12px; letter-spacing: .06em; color: var(--muted-on, var(--muted)); }

  .muted { color: var(--muted-on, var(--muted)); font-size: 16px; margin-top: 14px; max-width: 34em; }
  .process-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .process h2 { font-size: clamp(26px, 3vw, 38px); font-weight: 600; margin-top: 16px; }
  .process-link { margin-top: 24px; }
  .proc-list { list-style: none; display: flex; flex-direction: column; }
  .proc-list li {
    display: flex; gap: 16px; align-items: baseline;
    padding: 18px 0; border-top: 1px solid var(--rule, var(--hairline));
    font-size: 16px;
  }
  .proc-list li:last-child { border-bottom: 1px solid var(--rule, var(--hairline)); }
  .proc-list .no { color: var(--accent-on, var(--accent)); font-size: 13px; flex: 0 0 auto; }

  @media (max-width: 900px) {
    .process-grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
