---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnswerBlock from "../../components/AnswerBlock.astro";
import EarlyBirdForm from "../../components/EarlyBirdForm.astro";
import SectionHead from "../../components/SectionHead.astro";
import FAQ from "../../components/FAQ.astro";
import { chatgptAds, chatgptBetaNote, chatgptPromoNote } from "../../data/tarifs";
import { site } from "../../data/site";
import { serviceSchema, breadcrumbSchema, type FaqItem } from "../../lib/schema";

const title = "ChatGPT Ads en Suisse : lancez vos annonces maintenant | Flash Ads";
const description =
  "La publicité ChatGPT est ouverte en Suisse depuis le 24 août 2026. Offre de lancement Flash Ads : gestion complète à 240.-/mois et setup à 150.- jusqu'au 31 décembre. Budget dès 20.-/jour.";
const path = "/services/chatgpt-ads";

/** Ouverture du canal en Suisse. Source : annonce OpenAI (lien dans la frise). */
const launch = {
  iso: "2026-08-24",
  label: "24 août 2026",
  source: "https://openai.com/index/chatgpt-ads-expands-across-europe/",
};

/** Documentation annonceurs d'OpenAI : format, ciblage, enchères, mesure. */
const openaiDocs = "https://help.openai.com/en/articles/20001207-ads-in-chatgpt-the-basics";

// Date de mise à jour visible (les moteurs génératifs privilégient le contenu frais).
const updated = new Date("2026-09-18");
const updatedStr = updated.toLocaleDateString("fr-CH", { year: "numeric", month: "long", day: "numeric" });
const updatedISO = updated.toISOString().slice(0, 10);

const faqItems: FaqItem[] = [
  {
    question: "La publicité ChatGPT est-elle disponible en Suisse ?",
    answer:
      "Oui, depuis le 24 août 2026. OpenAI a ouvert ChatGPT Ads à l'Europe, Suisse comprise. La régie s'appelle Ads Manager et reste officiellement en bêta : le canal fonctionne, mais il évolue encore et ses performances ne sont pas stabilisées.",
  },
  {
    question: "Qu'est-ce que la publicité ChatGPT (ChatGPT Ads) ?",
    answer:
      "Ce sont des annonces sponsorisées affichées sous certaines réponses de ChatGPT, clairement labellisées comme publicités. Elles n'influencent pas le contenu des réponses générées par l'IA. Le format a été lancé en test aux États-Unis le 9 février 2026, puis ouvert en self-service aux entreprises américaines le 5 mai 2026, avant l'Europe en août 2026.",
  },
  {
    question: "Qui voit ces annonces ?",
    answer:
      "Les utilisateurs des formules gratuites de ChatGPT. Selon OpenAI, aucune annonce n'est diffusée aux abonnés Plus, Pro ou aux comptes Business, ni aux comptes identifiés comme appartenant à des personnes de moins de 18 ans. C'est une différence importante avec Google : votre audience est celle qui n'a pas payé pour retirer la publicité.",
  },
  {
    question: "À quoi ressemble une annonce ?",
    answer:
      "Elle apparaît sous la réponse de ChatGPT et comprend le nom de l'annonceur, son favicon, un titre, un texte de description, une image et un lien vers votre site. Le bloc est identifié comme sponsorisé et séparé visuellement de la réponse. On est proche d'une annonce Search enrichie d'un visuel.",
  },
  {
    question: "Comment cible-t-on ses annonces ?",
    answer:
      "Pas avec des mots-clés en correspondance exacte, contrairement à Google Ads. Vous fournissez au niveau du groupe d'annonces des indices de contexte : les sujets, thèmes ou mots-clés pour lesquels votre offre est pertinente. Le système s'appuie ensuite sur l'intention de la conversation en cours, sur votre page de destination et sur vos textes pour décider s'il affiche l'annonce. Ces indices orientent la diffusion, ils ne la garantissent pas. C'est un changement de métier réel : on ne pilote plus une liste de mots-clés, on décrit un contexte.",
  },
  {
    question: "Combien coûte un clic sur ChatGPT Ads ?",
    answer:
      "OpenAI recommande de démarrer avec une enchère maximale de 3 à 5 dollars par clic. C'est un plafond, pas le prix payé : les enchères fonctionnent au second prix pondéré par la pertinence, donc le coût réel est souvent inférieur. Trois modes de facturation existent : à l'impression, au clic, ou optimisé conversions. Ces repères viennent du lancement et bougeront avec la concurrence.",
  },
  {
    question: "Combien ça coûte chez Flash Ads ?",
    answer:
      "Deux montants distincts, comme pour Google Ads. D'abord votre budget publicitaire, versé directement à OpenAI : 20.- par jour au minimum, soit environ 600.- par mois. Ensuite nos frais de gestion : 240.- par mois au tarif de lancement, plus 150.- de setup une seule fois. Ces deux tarifs sont réduits de moitié jusqu'au 31 décembre 2026 ; à partir du 1er janvier 2027, la gestion passe à 480.- par mois.",
  },
  {
    question: "Pourquoi un budget minimum de 20.- par jour ?",
    answer:
      "Faisons le calcul ensemble : avec une enchère de l'ordre de 3 à 5 dollars par clic, 20.- par jour achètent quelques clics quotidiens seulement. C'est le strict minimum pour accumuler assez de données en un mois et commencer à optimiser. En dessous, vous paieriez des frais de gestion pour un résultat purement aléatoire. C'est la même logique que notre plancher de 500.- par mois sur Google Ads.",
  },
  {
    question: "Quels résultats puis-je attendre ?",
    answer:
      "Nous ne promettons aucun chiffre, et méfiez-vous de qui le ferait. La régie est en bêta, les volumes de recherche, les coûts par clic et les taux de conversion ne sont pas stabilisés, et personne ne dispose encore d'historique sur le marché suisse. Ce que nous garantissons, c'est le travail et la transparence : vous voyez ce qui est dépensé, ce que ça rapporte, et nous vous disons franchement si le canal ne fonctionne pas pour vous.",
  },
  {
    question: "Peut-on mesurer les résultats ?",
    answer:
      "Oui. L'Ads Manager remonte les impressions, les clics, la dépense, le taux de clic, le coût par clic et par mille impressions, ainsi que les conversions. Les paramètres de suivi que nous ajoutons à vos liens (UTM) sont conservés au clic, donc le trafic ChatGPT apparaît aussi dans votre Google Analytics, à côté de vos autres canaux. Une réserve honnête : les impressions et les clics remontent en quelques minutes, la dépense met plus longtemps, un montant à zéro ne veut donc pas dire qu'il n'y a pas eu de frais.",
  },
  {
    question: "Mes annonces peuvent-elles apparaître à côté de n'importe quelle conversation ?",
    answer:
      "Non. OpenAI applique une politique de brand safety : les annonces ne sont pas censées apparaître dans des contextes sensibles ou inappropriés, selon des règles publiées dans ses Ads Policies. Comme sur tout réseau publicitaire, c'est un dispositif de garde-fous, pas une garantie absolue.",
  },
  {
    question: "Pourquoi se lancer maintenant plutôt qu'attendre ?",
    answer:
      "Parce que l'avantage au premier entrant est réel : sur un canal neuf et peu concurrentiel, les annonceurs présents tôt apprennent plus vite et paient moins cher. C'est aussi la raison de notre tarif de lancement : nous voulons des premiers comptes pour apprendre ce canal avec vous.",
  },
  {
    question: "Est-ce que ça remplace Google Ads ?",
    answer:
      "Non, c'est un canal complémentaire. Google Ads reste le volume principal pour une PME romande. ChatGPT Ads capte un autre moment : celui où quelqu'un pose une question à une IA plutôt que de taper une recherche. Les deux se gèrent séparément, et vous pouvez tout à fait commencer par l'un.",
  },
];

const jsonLd = [
  serviceSchema({
    name: "Gestion de publicité ChatGPT (ChatGPT Ads)",
    description,
    url: path,
    serviceType: "Publicité en ligne (ChatGPT Ads)",
  }),
  {
    "@context": "https://schema.org",
    "@type": "Offer",
    name: `ChatGPT Ads ${chatgptAds.name}`,
    description: `Gestion complète de vos campagnes ChatGPT Ads. Tarif de lancement, puis ${chatgptAds.regularPriceValue}.-/mois.`,
    url: `${site.url}${path}`,
    priceCurrency: "CHF",
    price: chatgptAds.priceValue,
    priceValidUntil: chatgptAds.promoEndsISO,
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      priceCurrency: "CHF",
      price: chatgptAds.priceValue,
      unitCode: "MON",
    },
    seller: { "@type": "Organization", name: site.name, url: site.url },
  },
  breadcrumbSchema([
    { name: "Accueil", url: "/" },
    { name: "Services", url: path },
    { name: "Publicité ChatGPT", url: path },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="page-hero band band--tint">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a> <span aria-hidden="true">/</span> <span>Publicité ChatGPT</span>
      </nav>
      <span class="eyebrow">Ouvert en Suisse depuis le {launch.label}</span>
      <h1 class="display">La publicité <span class="flash-word">ChatGPT</span> est ouverte en Suisse.</h1>
      <p class="updated mono">Mis à jour le <time datetime={updatedISO}>{updatedStr}</time></p>

      <AnswerBlock>
        <p>
          <b>La publicité ChatGPT (ChatGPT Ads)</b> désigne des annonces sponsorisées affichées sous
          certaines réponses de ChatGPT, clairement labellisées et sans influence sur le contenu
          généré. Le format est <b>disponible en Suisse depuis le {launch.label}</b>. Flash Ads gère
          vos campagnes pour <b>{chatgptAds.price}{chatgptAds.unit}</b> au tarif de lancement, avec
          un budget publicitaire à partir de <b>{chatgptAds.minBudgetDaily}.- par jour</b> versé
          directement à OpenAI. Canal récent : aucun résultat n'est garanti.
        </p>
      </AnswerBlock>

      <div class="hero-cta">
        <a href="#offre" class="btn btn-primary">Voir l'offre de lancement <span class="arrow" aria-hidden="true">→</span></a>
        <a href="#demande" class="btn btn-ghost">Nous contacter</a>
      </div>
    </div>
  </section>

  <!-- OFFRE (CTA principal de la page) -->
  <section id="offre" class="band band--paper">
    <div class="wrap">
      <SectionHead
        eyebrow="Offre de lancement"
        title="Un seul pack, toute la gestion comprise."
        text="Nous ouvrons un nombre limité de comptes pour apprendre ce canal avec nos clients. D'où un tarif de lancement, réduit de moitié jusqu'à la fin de l'année."
      />

      <div class="offer-grid">
        <div class="price feat">
          <span class="badge">Jusqu'au 31.12</span>
          <span class="tier">{chatgptAds.name}</span>
          <div class="amt">
            {chatgptAds.price}<small> {chatgptAds.unit}</small>
          </div>
          <p class="was">
            au lieu de <s>{chatgptAds.regularPrice}{chatgptAds.unit}</s> · setup {chatgptAds.setup}
            au lieu de <s>{chatgptAds.regularSetup}</s>
          </p>
          <div class="rows">
            {chatgptAds.attributes.map((a) => (
              <div class="row">
                <span class="k">{a.label}</span>
                <span class="v">{a.value}</span>
              </div>
            ))}
          </div>
          <a href="#demande" class="btn btn-primary offer-cta">
            {chatgptAds.ctaLabel}<span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="offer-notes">
          <div class="note-card">
            <h3>Ce que vous payez, en clair</h3>
            <ul>
              <li>
                <b>{chatgptAds.setup} une seule fois</b> : ouverture du compte annonceur, tracking et
                première campagne. Au lieu de {chatgptAds.regularSetup}.
              </li>
              <li>
                <b>{chatgptAds.price} par mois</b> de frais de gestion, jusqu'au
                {" "}{chatgptAds.promoEndsLabel}. Ensuite {chatgptAds.regularPrice} par mois.
              </li>
              <li>
                <b>{chatgptAds.minBudgetDaily}.- par jour minimum</b> de budget publicitaire, soit
                environ {chatgptAds.minBudgetMonthly}.- par mois, payé directement à OpenAI sur votre
                propre compte. Nous ne prenons aucune commission dessus.
              </li>
            </ul>
            <p class="promo-note">{chatgptPromoNote}</p>
          </div>

          <div class="note-card beta">
            <h3>Ce que nous ne promettons pas</h3>
            <p>{chatgptBetaNote}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMAT -->
  <section class="section-alt band band--tint">
    <div class="wrap">
      <SectionHead
        eyebrow="Le format"
        title="Des annonces clairement séparées des réponses."
        text="La publicité n'altère pas les réponses de l'IA : elle s'affiche à côté, identifiée comme telle."
      />
      <div class="cards3">
        <div class="card">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" /></svg></div>
          <h3>Sous la réponse</h3>
          <p>L'annonce apparaît après la réponse de ChatGPT, dans une zone identifiée. Elle comprend votre nom, votre favicon, un titre, un texte, une image et le lien vers votre site.</p>
        </div>
        <div class="card">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg></div>
          <h3>Clairement labellisée</h3>
          <p>Chaque annonce est marquée comme publicité. L'utilisateur sait ce qui est sponsorisé et ce qui ne l'est pas.</p>
        </div>
        <div class="card">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M12 20V10M18 20V4M6 20v-4" /></svg></div>
          <h3>On paie au clic</h3>
          <p>Vous payez quand quelqu'un clique. OpenAI recommande de démarrer autour de 3 à 5 dollars d'enchère maximale : c'est un plafond, l'enchère au second prix fait souvent payer moins.</p>
        </div>
      </div>
      <p class="fmt-source">
        Format, ciblage, enchères et mesure :
        <a href={openaiDocs} target="_blank" rel="noopener">documentation annonceurs d'OpenAI</a>.
      </p>
    </div>
  </section>

  <!-- POURQUOI MAINTENANT -->
  <section class="why band band--night">
    <div class="wrap why-grid">
      <div>
        <span class="eyebrow">Pourquoi maintenant</span>
        <h2 class="display">Le premier entrant apprend plus vite et paie moins cher.</h2>
        <p class="muted">
          Sur un canal qui vient d'ouvrir, il y a peu d'annonceurs et les enchères sont basses. Ceux
          qui arrivent en premier accumulent des données pendant que les autres attendent. C'est la
          même raison qui nous pousse à ouvrir un tarif de lancement : nous voulons des premiers
          comptes pour apprendre ce canal avec vous, franchement, résultats à l'appui.
        </p>
        <a href="#demande" class="btn btn-ghost why-link">Nous contacter <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="why-panel">
        <span class="eyebrow">État du déploiement</span>
        <ul class="timeline mono">
          <li><b>9 fév. 2026</b> : test aux États-Unis (Free + Go)</li>
          <li><b>5 mai 2026</b> : Ads Manager self-serve ouvert aux entreprises US</li>
          <li><b>2026</b> : expansion Canada, Australie, Nouvelle-Zélande</li>
          <li class="live"><b>{launch.label}</b> : ouverture en Europe, Suisse comprise</li>
        </ul>
        <p class="tl-source">
          Source :
          <a href={launch.source} target="_blank" rel="noopener">annonce officielle d'OpenAI</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- DEMANDE D'ACCÈS -->
  <section id="demande" class="ask band band--tint">
    <div class="wrap">
      <div class="ask-box">
        <span class="eyebrow">Demande d'accès</span>
        <h2 class="display">Parlons-en avant que le tarif remonte.</h2>
        <p class="muted">
          Dites-nous ce que vous vendez. Nous vous répondons sous un jour ouvré et vous disons
          franchement si ChatGPT Ads a du sens pour votre activité, ou si votre budget est mieux
          placé sur Google Ads.
        </p>
        <EarlyBirdForm />
        <p class="ask-direct">
          Vous préférez écrire ou appeler ?
          <a href={`mailto:${site.email}`}>{site.email}</a> ·
          <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
        </p>
      </div>
    </div>
  </section>

  <FAQ items={faqItems} title="Questions fréquentes sur la publicité ChatGPT" eyebrow="FAQ · ChatGPT Ads" band="paper" />
</BaseLayout>

<style>
  .page-hero { padding: 72px 0 20px; }
  .crumbs { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-on, var(--muted)); margin-bottom: 22px; }
  .crumbs a { text-decoration: none; color: var(--muted-on, var(--muted)); }
  .crumbs a:hover { color: var(--accent-on, var(--accent)); }
  .page-hero h1 { font-size: clamp(34px, 4.6vw, 56px); font-weight: 600; margin: 18px 0 10px; max-width: 15em; }
  .updated { font-size: 12px; color: var(--muted-on, var(--muted)); margin-bottom: 22px; }
  .hero-cta { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }

  /* ── Offre ── */
  .offer-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 28px; align-items: start; }
  .offer-grid .price { max-width: none; }
  .was { font-size: 13px; color: var(--muted-on, var(--muted)); margin-bottom: 4px; }
  .was s { color: var(--on-faint, var(--faint)); }
  .offer-cta { justify-content: center; width: 100%; margin-top: auto; }
  .offer-notes { display: flex; flex-direction: column; gap: 16px; }
  .note-card {
    background: var(--surface-on, var(--paper));
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--r);
    padding: 26px 28px;
  }
  .note-card h3 { font-family: var(--font-display); font-weight: 600; font-size: 18px; }
  .note-card ul { list-style: none; margin-top: 16px; display: flex; flex-direction: column; gap: 12px; }
  .note-card li { font-size: 14.5px; color: var(--muted-on, var(--muted)); line-height: 1.6; padding-left: 18px; position: relative; }
  .note-card li::before { content: ""; position: absolute; left: 0; top: 9px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .note-card b { color: var(--on-strong, var(--ink)); font-weight: 600; }
  .promo-note { font-size: 12.5px; color: var(--muted-on, var(--muted)); line-height: 1.6; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--rule, var(--hairline)); }
  /* Le canal est jeune : cette carte doit se remarquer, pas se fondre. */
  .note-card.beta { border-left: 3px solid var(--fa-pink); }
  .note-card.beta p { font-size: 14.5px; color: var(--muted-on, var(--muted)); line-height: 1.6; margin-top: 12px; }

  .fmt-source { font-size: 12px; color: var(--on-faint, var(--faint)); margin-top: 26px; text-align: center; }
  .fmt-source a { color: var(--muted-on, var(--muted)); }

  .muted { color: var(--muted-on, var(--muted)); font-size: 16px; margin-top: 14px; max-width: 36em; }
  .why { padding-top: 64px; }
  .why-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
  .why h2 { font-size: clamp(26px, 3vw, 36px); font-weight: 600; margin-top: 16px; }
  .why-link { margin-top: 26px; }
  .why-panel { background: var(--surface-on, var(--paper)); border: 1px solid var(--rule, var(--hairline)); border-radius: var(--r); padding: 28px; }
  .timeline { list-style: none; margin-top: 18px; display: flex; flex-direction: column; gap: 14px; }
  .timeline li { font-size: 13px; color: var(--muted-on, var(--muted)); padding-left: 18px; position: relative; }
  .timeline li::before { content: ""; position: absolute; left: 0; top: 6px; width: 8px; height: 8px; border-radius: 50%; background: var(--flash-deep); }
  .timeline li.live { color: var(--on-strong, var(--ink)); font-weight: 600; }
  .timeline li.live::before { background: var(--fa-pink); box-shadow: 0 0 0 4px rgba(255, 46, 139, .16); }
  .tl-source { font-size: 11.5px; color: var(--on-faint, var(--faint)); margin-top: 18px; }
  .tl-source a { color: var(--muted-on, var(--muted)); }

  /* ── Demande d'accès ── */
  .ask-box {
    background: var(--surface-on, var(--paper));
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--radius-2xl);
    padding: 48px;
  }
  .ask-box h2 { font-size: clamp(26px, 3vw, 36px); font-weight: 600; margin-top: 16px; }
  .ask-box .muted { margin-bottom: 28px; }
  .ask-direct { font-size: 13.5px; color: var(--muted-on, var(--muted)); margin-top: 22px; }
  .ask-direct a { color: var(--accent-on, var(--accent)); text-decoration: none; }

  @media (max-width: 900px) {
    .offer-grid, .why-grid { grid-template-columns: 1fr; gap: 28px; }
    .ask-box { padding: 28px; }
  }
</style>
