---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import CTA from "../../components/CTA.astro";
import { breadcrumbSchema } from "../../lib/schema";

const title = "Blog Google Ads & publicité IA pour PME | Flash Ads";
const description =
  "Conseils concrets sur Google Ads, le budget publicitaire, le tracking et la publicité IA pour les PME en Suisse romande. Des réponses claires, sans jargon.";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const jsonLd = [
  breadcrumbSchema([
    { name: "Accueil", url: "/" },
    { name: "Blog", url: "/blog" },
  ]),
];
---

<BaseLayout title={title} description={description} path="/blog" jsonLd={jsonLd}>
  <section class="blog-hero">
    <div class="wrap">
      <span class="eyebrow">Le blog</span>
      <h1 class="display">Google Ads expliqué <span class="flash-word">simplement</span>.</h1>
      <p class="lead">
        Des réponses concrètes aux questions que se posent les dirigeants de PME : combien ça coûte,
        comment ça marche, où va le budget. Sans jargon.
      </p>
    </div>
  </section>

  <section class="blog-list-section">
    <div class="wrap">
      {
        posts.length === 0 ? (
          <p class="empty mono">Les premiers articles arrivent bientôt.</p>
        ) : (
          <div class="blog-grid">
            {posts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                href={`/blog/${post.id}`}
                pubDate={post.data.pubDate}
                category={post.data.category}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .blog-hero { padding: 80px 0 20px; }
  .blog-hero h1 { font-size: clamp(34px, 5vw, 58px); font-weight: 600; margin: 18px 0 0; }
  .lead { font-size: 19px; color: var(--muted); max-width: 34em; margin-top: 20px; }
  .blog-list-section { padding-top: 40px; }
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .empty { color: var(--muted); }
  @media (max-width: 900px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
