---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import GooglePartnerBadge from "../components/GooglePartnerBadge.astro";
import GoogleRating from "../components/GoogleRating.astro";
import CTA from "../components/CTA.astro";
import { site } from "../data/site";

const linkedin = Object.fromEntries(site.founders.map((f) => [f.id, f]));
import { breadcrumbSchema } from "../lib/schema";

const title = "L'agence Flash Ads : notre façon de faire | Flash Ads";
const description =
  "Qui est Flash Ads : deux associés complémentaires, un ancrage suisse, et un seul métier : la publicité en ligne. Une façon de faire claire en quatre étapes. Simple, transparent, efficace.";
const path = "/agence";

const jsonLd = [
  breadcrumbSchema([
    { name: "Accueil", url: "/" },
    { name: "Agence", url: path },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="page-hero band band--tint">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">L'agence</span>
          <h1 class="display">Un seul métier : la pub en ligne. Et on le fait <span class="flash-word">bien.</span></h1>
          <p class="lead">
            Flash Ads est née d'une conviction simple : la publicité en ligne ne devrait pas être une
            boîte noire. On ne fait que ça (pas de site web, pas de logo, pas de réseaux sociaux) pour
            le faire vraiment bien. Prix affichés, budget qui reste chez vous, rapports clairs. C'est tout.
          </p>
          <GoogleRating spaced />
          <p class="baseline mono">{site.baseline}</p>
          <div class="hero-badge"><GooglePartnerBadge height={60} /><span class="mono">Agence certifiée Google Partner</span></div>
        </div>
        <!-- Illustration générée (Codex), décorative : deux profils complémentaires, une boîte ouverte. -->
        <img class="hero-visual" src="/images/agence/hero.webp" width="1200" height="874" alt="" decoding="async" />
      </div>
    </div>
  </section>

  <!-- QUI NOUS SOMMES -->
  <section class="band band--paper">
    <div class="wrap">
      <SectionHead
        eyebrow="Qui nous sommes"
        title="Deux profils complémentaires, un seul standard de qualité."
        text="La complémentarité technique + commerciale est notre force : on construit des systèmes solides et on sait les expliquer simplement."
      />
      <div class="cards2">
        <div class="founder">
          <img class="portrait" src="/images/equipe/hippo.webp" width="560" height="700" alt="Portrait de Hippolyte, associé de Flash Ads" loading="lazy" decoding="async" />
          <p class="name">Hippolyte</p>
          <h3 class="display">Le profil technique & opérationnel</h3>
          <p class="role mono">Campagnes · Automatisation · Mesure</p>
          <p>
            Crée et améliore les campagnes, met en place la mesure et automatise les rapports.
            L'obsession : que chaque franc dépensé serve à amener des clients.
          </p>
          <a class="li-badge" href={linkedin.hippolyte.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`Profil LinkedIn de ${linkedin.hippolyte.name} (nouvel onglet)`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9.75h4V21H3V9.75zm6.5 0h3.8v1.55h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V21h-4v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.91 1.3-1.91 2.63V21h-4V9.75z" /></svg>
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="founder">
          <img class="portrait" src="/images/equipe/karim.webp" width="560" height="700" alt="Portrait de Karim, associé de Flash Ads" loading="lazy" decoding="async" />
          <p class="name">Karim</p>
          <h3 class="display">Le profil commercial & relation client</h3>
          <p class="role mono">Vente · Visibilité · Relation client</p>
          <p>
            Comprend votre marché, traduit vos objectifs en stratégie et reste votre interlocuteur clair.
            L'obsession : que vous sachiez toujours où vous en êtes.
          </p>
          <a class="li-badge" href={linkedin.karim.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`Profil LinkedIn de ${linkedin.karim.name} (nouvel onglet)`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9.75h4V21H3V9.75zm6.5 0h3.8v1.55h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V21h-4v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.91 1.3-1.91 2.63V21h-4V9.75z" /></svg>
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- MÉTHODE détaillée -->
  <section id="methode" class="method-detail band band--night">
    <div class="wrap">
      <SectionHead
        eyebrow="Notre façon de faire"
        title="Du premier échange au suivi de chaque semaine."
        text="Le même déroulé clair pour chaque client. Pas de boîte noire : vous savez ce qu'on fait, quand, et pourquoi."
      />
      <div class="steps-full">
        <div class="step-full">
          <span class="no mono">01</span>
          <div><h3 class="display">On regarde, gratuitement</h3><p>On analyse votre situation ou votre compte existant. On vous dit franchement si la pub Google vaut le coup pour vous. Et si non, on le dit aussi.</p></div>
        </div>
        <div class="step-full">
          <span class="no mono">02</span>
          <div><h3 class="display">On installe la mesure</h3><p>On met en place les outils qui montrent ce qui marche, et on les teste. Sans chiffres fiables, impossible de bien régler les campagnes.</p></div>
        </div>
        <div class="step-full">
          <span class="no mono">03</span>
          <div><h3 class="display">On crée vos annonces</h3><p>On construit vos campagnes et on choisit les bons mots, adaptés à votre métier, sur des méthodes éprouvées.</p></div>
        </div>
        <div class="step-full">
          <span class="no mono">04</span>
          <div><h3 class="display">On améliore et on vous tient au courant</h3><p>On ajuste en continu et on vous envoie un rapport clair : les chiffres clés, ce qu'on a fait, la suite. Suivi de notre côté chaque semaine.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- VALEURS -->
  <section class="values band band--paper">
    <div class="wrap">
      <div class="values-grid">
        <div>
          <span class="eyebrow">Nos valeurs</span>
          <h2 class="display">Trois principes non négociables.</h2>
          <p class="values-lead">
            Vous parlez directement aux deux personnes qui gèrent vos campagnes, pas à un intermédiaire.
            Et on travaille selon trois règles simples.
          </p>
          <!-- Photo générée à partir de portraits réels des deux associés, noir et blanc comme les portraits. -->
          <img class="duo" src="/images/equipe/duo.webp" width="1000" height="667" alt="Hippolyte et Karim, les deux associés de Flash Ads, en discussion autour d'un ordinateur portable" loading="lazy" decoding="async" />
        </div>
        <div class="values-list">
        <div class="card">
          <h3>Tout est clair</h3>
          <p>Accès à votre compte, rapports simples, aucune zone d'ombre. Vous voyez exactement ce qu'on fait et ce que ça donne.</p>
        </div>
        <div class="card">
          <h3>Prix affichés</h3>
          <p>Un montant fixe pour la gestion, jamais une commission sur votre budget. Votre argent de pub reste chez vous, versé à Google.</p>
        </div>
        <div class="card">
          <h3>Engagement court</h3>
          <p>3 mois au départ, le temps que Google Ads produise des données fiables. Ensuite, résiliable chaque mois : vous restez pour les résultats, pas par obligation.</p>
        </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .hero-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 56px; align-items: center; }
  .hero-visual { display: block; width: 100%; max-width: 420px; height: auto; justify-self: end; }
  .page-hero { padding: 80px 0 20px; }
  .page-hero h1 { font-size: clamp(34px, 5vw, 60px); font-weight: 600; margin: 18px 0 0; max-width: 16em; }
  .lead { font-size: 19px; color: var(--muted-on, var(--muted)); max-width: 34em; margin-top: 22px; }
  .baseline { margin-top: 20px; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--on-faint, var(--faint)); }
  .hero-badge { display: flex; align-items: center; gap: 14px; margin-top: 24px; }
  .hero-badge .mono { font-size: 12px; letter-spacing: .06em; color: var(--muted-on, var(--muted)); }

  .cards2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .founder { background: var(--surface-on, var(--paper)); border: 1px solid var(--rule, var(--hairline)); border-radius: var(--r); padding: 30px; }
  /* Portraits noir et blanc : simple filet, aucune ombre (hors de la liste fermée). */
  .portrait { display: block; width: 100%; max-width: 220px; height: auto; border: 1px solid var(--rule, var(--hairline)); border-radius: var(--r); margin-bottom: 20px; }
  .founder .name { font-family: var(--font-display); font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--on-strong, var(--ink)); margin-bottom: 6px; }

  .values-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .values-grid h2 { font-size: clamp(26px, 3vw, 38px); font-weight: 600; margin-top: 16px; }
  .values-lead { color: var(--muted-on, var(--muted)); font-size: 16px; margin-top: 14px; max-width: 34em; }
  .duo { display: block; width: 100%; height: auto; border: 1px solid var(--rule, var(--hairline)); border-radius: var(--r); margin-top: 28px; }
  .values-list { display: flex; flex-direction: column; gap: 20px; }
  .founder h3 { font-size: 21px; font-weight: 600; }
  .founder .role { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-on, var(--accent)); margin: 6px 0 14px; }
  .founder p { color: var(--muted-on, var(--muted)); font-size: 15px; }
  /* Badge LinkedIn : pilule à filet, sans ombre (hors de la liste fermée). */
  .li-badge {
    display: inline-flex; align-items: center; gap: 7px; margin-top: 18px;
    padding: 6px 12px; border: 1px solid var(--rule, var(--hairline)); border-radius: var(--radius-pill);
    font-family: var(--font-display); font-size: 13px; font-weight: 600;
    color: var(--accent-on, var(--accent)); text-decoration: none;
    transition: border-color .15s;
  }
  .li-badge svg { width: 14px; height: 14px; fill: currentColor; }
  .li-badge:hover { border-color: var(--accent-on, var(--accent)); }
  .li-badge:focus-visible { outline: 3px solid var(--fa-pink); outline-offset: 3px; }

  .method-detail .steps-full {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 48px;
    border-bottom: 1px solid var(--rule, var(--hairline));
  }
  .step-full { display: grid; grid-template-columns: auto 1fr; gap: 28px; padding: 28px 0; border-top: 1px solid var(--rule, var(--hairline)); }
  .step-full .no { font-size: 14px; color: var(--accent-on, var(--accent)); padding-top: 6px; }
  .step-full h3 { font-size: 20px; font-weight: 600; }
  .step-full p { color: var(--muted-on, var(--muted)); font-size: 15px; margin-top: 6px; max-width: 48em; }

  @media (max-width: 900px) {
    .cards2, .values-grid { grid-template-columns: 1fr; }
    .method-detail .steps-full { grid-template-columns: 1fr; column-gap: 0; }
    .step-full { gap: 18px; }
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .hero-visual { max-width: 300px; justify-self: start; }
  }
</style>
