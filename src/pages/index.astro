---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdPreview from "../components/AdPreview.astro";
import AnswerBlock from "../components/AnswerBlock.astro";
import SectionHead from "../components/SectionHead.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import PricingGrid from "../components/PricingGrid.astro";
import Testimonials from "../components/Testimonials.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import GooglePartnerBadge from "../components/GooglePartnerBadge.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import { ui } from "../i18n/fr";
import { site } from "../data/site";
import { keyStats } from "../data/temoignages";
import { serviceSchema, type FaqItem } from "../lib/schema";

const title = "Agence Google Ads en Suisse romande pour PME | Flash Ads";
const description =
  "Agence Google Ads pour PME en Suisse romande : plus de clients avec la publicité Google. Prix fixes et publics dès 390.-/mois, 0% de commission sur votre budget. Audit gratuit.";

const faqItems: FaqItem[] = [
  {
    question: "Combien ça coûte ?",
    answer:
      "Quatre packs à prix fixes et publics, de 390.- à 1190.- par mois (sur mesure dès 1490.-), selon votre budget publicitaire mensuel. S'ajoute un setup tracking obligatoire de 300.-, payé une seule fois avant le lancement. Votre budget de pub, lui, est payé directement à Google : on ne prend aucune commission dessus.",
  },
  {
    question: "Comment savoir quel pack choisir ?",
    answer:
      "Un seul critère : votre budget publicitaire mensuel. Moins de 1200.- : Starter. De 1200 à 5000.- : Croissance. De 5000 à 15000.- : Performance. Au-delà : sur mesure. Si vous ne connaissez pas encore votre budget idéal, il se calcule à partir de la valeur d'un client et du nombre de clients que vous visez. C'est la première chose qu'on regarde ensemble.",
  },
  {
    question: "Qui paie le budget publicitaire ?",
    answer:
      "Vous, directement à Google, avec votre propre carte sur votre propre compte Google Ads. Flash Ads ne touche jamais ce budget et ne prend aucun pourcentage dessus. Vous voyez exactement ce que Google facture, et nous n'avons aucun intérêt à gonfler vos dépenses : nos frais de gestion sont fixes.",
  },
  {
    question: "À partir de quel budget ça vaut la peine ?",
    answer:
      "À partir de 500 CHF par mois de budget publicitaire : c'est notre seuil, et il est ferme. En dessous, les campagnes ne génèrent pas assez de données pour être optimisées et vous paieriez des frais de gestion pour rien. Plutôt que d'encaisser en sachant que ça ne marchera pas, on préfère vous conseiller d'attendre d'avoir ce budget.",
  },
  {
    question: "Que se passe-t-il si mon budget augmente en cours de route ?",
    answer:
      "Le pack suit le budget : si votre budget publicitaire dépasse durablement la limite de votre pack, vous passez au pack supérieur le mois suivant, sans frais. Et c'est une bonne nouvelle : en général, le budget augmente parce que les campagnes rapportent.",
  },
  {
    question: "Pourquoi un engagement initial de 3 mois ?",
    answer:
      "Parce que Google Ads a besoin de 6 à 8 semaines de données avant que l'optimisation produise des résultats fiables. Un client qui part au bout d'un mois n'a rien vu des résultats réels. Après les 3 premiers mois, vous pouvez résilier chaque mois, sans pénalité.",
  },
  {
    question: "Comment se passe la facturation ?",
    answer:
      "Un abonnement mensuel, prélevé automatiquement en début de mois par carte ou TWINT via Stripe. Les frais de setup (tracking, Shopping, landing page) sont facturés une seule fois, avant le lancement. Un changement de pack se fait au mois suivant, sans frais.",
  },
  {
    question: "Vos prix incluent-ils la TVA ?",
    answer:
      "Flash Ads n'est pas assujettie à la TVA à ce jour : les prix affichés sont donc nets, sans TVA. En cas d'assujettissement futur, les prix pourront être ajustés conformément aux CGV.",
  },
  {
    question: "Faut-il un rendez-vous avant de commencer ?",
    answer:
      "Non, ce n'est pas obligatoire. Nos prix sont publics et le pack se choisit sur un seul critère, votre budget publicitaire : vous pouvez comparer et nous écrire directement. On garde quand même un court échange au démarrage pour bien comprendre votre activité. Et le pack Sur mesure, lui, commence toujours par une discussion.",
  },
  {
    question: "Faites-vous aussi des sites web ou des réseaux sociaux ?",
    answer:
      "Non. On ne fait que de la publicité en ligne. C'est notre seul métier, et c'est exactement pour ça qu'on le fait bien. Pour le reste, on peut vous recommander des partenaires de confiance.",
  },
];

const jsonLd = [
  serviceSchema({
    name: "Gestion de campagnes Google Ads pour PME",
    description,
    url: "/",
    serviceType: "Publicité en ligne (Google Ads)",
    withPricing: true, // offres tarifaires (émises seulement si pricingValidated)
  }),
];
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero band band--tint">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Agence Google Ads pour PME · Suisse romande</span>
        <h1 class="display">
          Plus de clients grâce à Google, à un prix <span class="flash-word">clair et sans surprise.</span>
        </h1>
        <p class="lead">
          On s'occupe de votre publicité sur Google pour vous amener plus de clients. Vous gardez la
          main sur votre budget, payé directement à Google. Des packs fixes et publics, 0% de
          commission, et vous voyez exactement ce que vous payez.
        </p>
        <div class="hero-cta">
          <a href="/contact" class="btn btn-primary">{ui.cta.quote} <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/#tarifs" class="btn btn-ghost">{ui.cta.seePricing}</a>
        </div>
        <p class="baseline mono">{site.baseline}</p>
      </div>
      <AdPreview />
    </div>
  </section>

  <!-- BANDEAU CONFIANCE : badge Google Partner + chiffres + logos -->
  <div class="trust band--paper">
    <div class="wrap trust-inner">
      <div class="trust-badge">
        <GooglePartnerBadge height={72} />
        <span class="mono">Agence certifiée Google Partner</span>
      </div>
      <div class="trust-stats">
        {keyStats.map((s) => (
          <div><span class="n display">{s.value}</span><span class="l mono">{s.label}</span></div>
        ))}
      </div>
    </div>
    <div class="wrap">
      <LogoMarquee />
    </div>
  </div>

  <!-- BLOC DE RÉPONSE DIRECTE (GEO) - définition extractible par les moteurs IA -->
  <section class="intro-answer band band--tint">
    <div class="wrap">
      <AnswerBlock question="Qu'est-ce que Flash Ads ?">
        <p>
          <b>Flash Ads</b> est une agence Google Ads pour PME en Suisse romande. Nous créons et gérons
          vos campagnes publicitaires sur Google contre un <b>forfait mensuel fixe et public</b>, dès
          390.-/mois, sans commission sur votre budget. Votre budget publicitaire est payé directement
          à Google et reste chez vous. Engagement initial de 3 mois, puis résiliable chaque mois.
        </p>
      </AnswerBlock>
    </div>
  </section>

  <!-- PROBLÈME / SOLUTION + SPÉCIALISTE -->
  <section class="problem band band--paper">
    <div class="wrap">
      <div class="problem-grid">
        <div class="tile">
          <span class="eyebrow">Le problème</span>
          <h2 class="display">Avec la plupart des agences, on ne sait pas ce qu'on paie.</h2>
          <p class="muted">
            Une commission sur votre budget qui grimpe quand vous dépensez plus. Un contrat qui vous
            retient. Des rapports compliqués où on ne comprend rien. Et toujours un rendez-vous de
            vente avant le moindre prix.
          </p>
        </div>
        <div class="tile">
          <span class="eyebrow">Notre façon de faire</span>
          <h2 class="display">Un seul métier, des prix affichés, zéro mauvaise surprise.</h2>
          <p class="muted">
            On ne fait <b>que</b> de la publicité en ligne : pas de site web, pas de logo, pas de
            réseaux sociaux. Juste vos campagnes, bien faites. Les prix sont sur le site, votre budget
            reste chez vous, et vous savez toujours ce qu'on fait et pourquoi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- POURQUOI FLASH ADS / USP -->
  <section class="why band band--night">
    <div class="wrap">
      <SectionHead
        eyebrow="Pourquoi nous choisir"
        title="Tout est pris en main, par une agence certifiée Google."
        text="Vous nous confiez votre publicité, on s'occupe du reste. Voici ce qui fait la différence."
      />
      <div class="cards4">
        <div class="card">
          <div class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M21 8l-9-5-9 5v8l9 5 9-5z" /><path d="M3 8l9 5 9-5" /><path d="M12 13v8" /></svg>
          </div>
          <h3>Service clé en main</h3>
          <p>On s'occupe de tout, de A à Z : création, réglages et suivi de vos campagnes. Vous n'avez rien à gérer : on vous amène les demandes.</p>
        </div>
        <div class="card">
          <div class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M12 3l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V6z" /><path d="M9 12l2 2 4-4" /></svg>
          </div>
          <h3>Agence certifiée Google</h3>
          <p>Nous sommes agence certifiée Google Partner. Vos campagnes sont montées par des personnes formées et reconnues par Google.</p>
        </div>
        <div class="card">
          <div class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M4 12a8 8 0 0113-6" /><path d="M20 5v4h-4" /><path d="M20 12a8 8 0 01-13 6" /><path d="M4 19v-4h4" /></svg>
          </div>
          <h3>Optimisation continue</h3>
          <p>On ne lance pas vos annonces pour les oublier. Chaque semaine, on les ajuste pour qu'elles vous rapportent toujours plus.</p>
        </div>
        <div class="card">
          <div class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M4 18a8 8 0 1116 0" /><path d="M12 18l4-5" /></svg>
          </div>
          <h3>Résultats rapides et mesurables</h3>
          <p>Les premières demandes arrivent vite, et vous voyez précisément ce que chaque franc rapporte. Des chiffres clairs, pas des promesses.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="band band--paper">
    <div class="wrap">
      <SectionHead
        eyebrow="Ce qu'on fait"
        title="On transforme votre budget de pub en clients."
        text="Pas de facturation à l'heure ni de commission. On met en place ce qu'il faut pour vous amener des demandes, simplement."
      />
      <div class="cards3">
        <ServiceCard title="Publicité Google" href="/services/google-ads" linkLabel="Gestion de campagnes Google Ads">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M3 17l6-6 4 4 8-8" /><path d="M21 7v6h-6" /></svg>
          Vos annonces s'affichent sur Google au moment où vos clients cherchent ce que vous proposez. On les crée et on les améliore en continu.
        </ServiceCard>
        <ServiceCard title="Publicité ChatGPT (ChatGPT Ads)" href="/services/chatgpt-ads" linkLabel="Découvrir ChatGPT Ads">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M12 2a4 4 0 014 4c2 0 4 2 4 4a4 4 0 01-1 7H7a5 5 0 01-1-9 4 4 0 016-5z" /></svg>
          La publicité sur ChatGPT est ouverte en Suisse depuis août 2026. On gère vos campagnes dès 240.-/mois, tarif de lancement.
        </ServiceCard>
        <ServiceCard title="Savoir ce qui marche" href="/services/tracking-analytics" linkLabel="Suivi de conversion & mesure">
          <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke-width="1.8"><path d="M4 19V5m4 14V9m4 10V7m4 12v-6m4 6V11" /></svg>
          On installe les outils qui montrent d'où viennent vos clients. Sans ça, on dépense à l'aveugle. On règle ça proprement.
        </ServiceCard>
      </div>
    </div>
  </section>

  <!-- TARIFS -->
  <section id="tarifs" class="band band--tint">
    <div class="wrap">
      <SectionHead
        eyebrow="Nos prix"
        title="Un prix fixe, affiché. Votre budget de pub reste chez vous."
        text="Quatre packs fixes, choisis sur un seul critère : votre budget publicitaire mensuel. Vous payez Google directement avec votre carte, 0% de commission."
      />
      <PricingGrid ctaHref="/contact" />
      <p class="pricing-tool">
        Vous ne savez pas encore combien investir chez Google ? Estimez-le en une minute avec notre
        <a href="/calculateur-budget">calculateur de budget Google Ads</a>, secteur par secteur.
      </p>
    </div>
  </section>

  <!-- MÉTHODE résumée -->
  <section id="methode" class="band band--night">
    <div class="wrap method">
      <div>
        <span class="eyebrow">Comment on travaille</span>
        <h2 class="display method-title">Un déroulé clair, du premier échange au premier client.</h2>
        <p class="muted method-intro">
          Pas de boîte noire. Vous savez ce qu'on fait, quand, et pourquoi. À chaque étape.
        </p>
        <a href="/agence" class="btn btn-ghost method-link">{ui.cta.discoverAgency} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="steps">
        <div class="step"><span class="no">01</span><div><h4>On regarde, gratuitement</h4><p>On analyse votre situation et on vous dit franchement si la pub Google vaut le coup pour vous.</p></div></div>
        <div class="step"><span class="no">02</span><div><h4>On installe la mesure</h4><p>On met en place les outils qui montrent ce qui marche. Sans ça, impossible de savoir où va votre argent.</p></div></div>
        <div class="step"><span class="no">03</span><div><h4>On crée vos annonces</h4><p>On construit vos campagnes et on choisit les bons mots, adaptés à votre métier.</p></div></div>
        <div class="step"><span class="no">04</span><div><h4>On améliore et on vous tient au courant</h4><p>On ajuste en continu et on vous envoie un rapport simple : ce qu'on a fait, ce que ça donne.</p></div></div>
      </div>
    </div>
  </section>

  <!-- TÉMOIGNAGES -->
  <section class="proof band band--tint">
    <div class="wrap">
      <SectionHead eyebrow="Ils en parlent" title="Ce que disent nos clients." />
      <Testimonials />
    </div>
  </section>

  <!-- RÉSULTATS / CAS -->
  <section id="cas" class="band band--paper">
    <div class="wrap">
      <SectionHead
        eyebrow="Résultats"
        title="Des chiffres, pas des promesses."
        text="Trois exemples parmi les PME romandes que nous accompagnons. Résultats mesurés sur le compte du client, tracking en place."
      />
      <div class="cases">
        <CaseStudyCard metric="+63%" who="Chauffage sanitaire · Valais">
          Deux tiers de demandes de devis en plus en six mois, à budget publicitaire constant.
        </CaseStudyCard>
        <CaseStudyCard metric="−29%" who="Cabinet dentaire · Lausanne">
          Chaque nouveau patient coûte près d'un tiers de moins qu'avant la reprise du compte.
        </CaseStudyCard>
        <CaseStudyCard metric="3,8×" who="Boutique en ligne · Genève">
          Pour 1 franc investi en publicité, 3,80 francs de ventes sur les douze derniers mois.
        </CaseStudyCard>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ items={faqItems} title="Vos questions, nos réponses." />

  <!-- CTA FINAL -->
  <CTA />
</BaseLayout>

<style>
  .pricing-tool { font-size: 14px; color: var(--muted-on, var(--muted)); text-align: center; margin-top: 22px; }
  .pricing-tool a { color: var(--accent-on, var(--accent)); text-decoration: none; font-weight: 500; }
  .pricing-tool a:hover { text-decoration: underline; }
  .hero { position: relative; padding: 64px 0 56px; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }
  .hero h1 { font-size: clamp(38px, 5.2vw, 56px); font-weight: 700; letter-spacing: -.035em; line-height: 1.08; margin: 18px 0 0; }
  .hero .lead { font-size: 19px; max-width: 31em; margin-top: 22px; }
  .hero-cta { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .baseline { margin-top: 22px; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--on-faint, var(--faint)); }

  /* Bandeau de confiance : certification, chiffres et logos disent la même
     chose, ils restent donc un seul bloc, sur blanc (les logos sont des WebP
     gris à fond blanc neutralisé, ils ne tiennent pas sur un fond coloré). */
  .trust { padding: 30px 0; }
  .trust-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .trust-badge { display: flex; align-items: center; gap: 16px; }
  .trust-badge .mono { font-size: 12px; letter-spacing: .08em; max-width: 14em; }
  .trust-stats { display: flex; gap: 40px; flex-wrap: wrap; }
  .trust-stats div { display: flex; flex-direction: column; gap: 3px; }
  .trust-stats .n { font-weight: 700; font-size: 28px; letter-spacing: -.02em; }
  .trust-stats .l { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }

  /* « Pourquoi nous choisir » : des lignes de grille, pas des boîtes. Quatre
     cadres de plus ici saturaient la page alors que les colonnes se lisent
     déjà seules. La séparation suit l'axe de la grille au fil des ruptures. */
  .cards4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .cards4 .card {
    background: none;
    border: 0;
    border-left: 1px solid var(--rule, var(--hairline));
    border-radius: 0;
    padding: 4px 24px;
  }
  .cards4 .card:hover { border-color: var(--rule, var(--hairline)); }
  .cards4 .card:first-child { border-left: 0; padding-left: 0; }
  /* Aucune boîte ici, pas même la pastille d'icône : l'icône vit à nu. */
  .cards4 :global(.ico) { background: none; width: auto; height: auto; place-items: start; margin-bottom: 14px; }
  .cards4 :global(.ico svg) { width: 26px; height: 26px; }
  .cards4 h3 { font-size: 18px; font-weight: 600; margin-top: 2px; }
  .cards4 p { color: var(--muted-on, var(--muted)); font-size: 14.5px; line-height: 1.6; margin-top: 8px; }

  .problem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  /* Le diptyque problème / réponse : deux cartes identiques. C'est le texte qui
     les oppose, pas deux fonds différents posés au milieu d'une bande claire. */
  .tile {
    background: var(--surface-on, var(--paper));
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--r);
    padding: 34px 32px;
  }
  .problem-grid h2 { font-size: clamp(23px, 2.7vw, 31px); font-weight: 600; margin-top: 14px; }
  .muted { font-size: 16px; margin-top: 14px; max-width: 33em; }

  .method-title { font-size: clamp(28px, 3.4vw, 40px); font-weight: 600; margin-top: 16px; }
  .method-intro { margin-top: 16px; }
  .method-link { margin-top: 26px; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero { padding: 48px 0 40px; }
    .problem-grid { grid-template-columns: 1fr; }
    .trust-inner { gap: 22px; }
    .cards4 { grid-template-columns: 1fr 1fr; row-gap: 28px; }
    .cards4 .card:nth-child(2n+1) { border-left: 0; padding-left: 0; }
    .cards4 .card:nth-child(n+3) { border-top: 1px solid var(--rule, var(--hairline)); padding-top: 28px; }
    .tile { padding: 28px 24px; }
  }

  /* Sur téléphone, la colonne de texte passe AU-DESSUS de l'aperçu d'annonce.
     Sans resserrement, l'aperçu tombait intégralement sous la ligne de
     flottaison (833 px de haut pour un écran de 844) : le visuel signature du
     hero était invisible à l'arrivée. On récupère la centaine de pixels qui
     permet d'en montrer le haut, donc d'inviter au défilement. */
  @media (max-width: 640px) {
    .hero { padding: 40px 0 32px; }
    .hero-grid { gap: 28px; }
    .hero h1 { margin: 14px 0 0; }
    .hero .lead { font-size: 17px; margin-top: 18px; }
    .hero-cta { margin-top: 24px; gap: 10px; }
    .baseline { margin-top: 16px; }
  }
  @media (max-width: 560px) {
    .cards4 { grid-template-columns: 1fr; row-gap: 24px; }
    .cards4 .card { border-left: 0; padding-left: 0; }
    .cards4 .card:nth-child(n+2) { border-top: 1px solid var(--rule, var(--hairline)); padding-top: 24px; }
  }
</style>
