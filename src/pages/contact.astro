---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { site } from "../data/site";
import { breadcrumbSchema } from "../lib/schema";

const title = "Contact : demander un audit gratuit | Flash Ads";
const description =
  "Demandez un audit gratuit pour la gestion de vos campagnes Google Ads. Réponse sous un jour ouvré. Indiquez votre budget publicitaire : il détermine votre pack, à prix fixe et public.";
const path = "/contact";

const jsonLd = [
  breadcrumbSchema([
    { name: "Accueil", url: "/" },
    { name: "Contact", url: path },
  ]),
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="contact band band--tint">
    <div class="wrap contact-grid">
      <div class="intro">
        <span class="eyebrow">Demande d'audit gratuit</span>
        <h1 class="display">Parlons de votre <span class="flash-word">croissance</span>.</h1>
        <p class="lead">
          Décrivez votre situation en deux lignes. On vous répond sous un jour ouvré avec une première
          lecture honnête, et le pack adapté à votre budget publicitaire, à prix fixe et public.
        </p>

        <ul class="reassure">
          <li><span class="chk" aria-hidden="true">✓</span> Audit gratuit de votre compte ou de votre marché</li>
          <li><span class="chk" aria-hidden="true">✓</span> Prix fixes et publics, 0% de commission sur votre budget</li>
          <li><span class="chk" aria-hidden="true">✓</span> Engagement initial de 3 mois, puis résiliable chaque mois</li>
        </ul>

        <div class="direct">
          <p class="mono lbl">Ou directement</p>
          <a href={`mailto:${site.email}`} class="mono">{site.email}</a>
          <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="mono">{site.phone}</a>
        </div>
      </div>

      <div class="form-wrap">
        <QuoteForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding: 56px 0 48px; }
  .contact-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 64px; align-items: start; }
  .intro h1 { font-size: clamp(34px, 4.4vw, 52px); font-weight: 600; margin: 18px 0 0; }
  .lead { font-size: 18px; color: var(--muted-on, var(--muted)); margin-top: 20px; max-width: 26em; }
  .reassure { list-style: none; margin: 28px 0; display: flex; flex-direction: column; gap: 12px; }
  .reassure li { display: flex; gap: 11px; align-items: center; font-size: 15px; }
  .chk { color: var(--accent-on, var(--accent)); font-weight: 700; }
  .direct { border-top: 1px solid var(--rule, var(--hairline)); padding-top: 22px; margin-top: 8px; display: flex; flex-direction: column; gap: 8px; }
  .direct .lbl { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted-on, var(--muted)); margin-bottom: 4px; }
  .direct a { font-size: 14px; color: var(--on-strong, var(--ink)); text-decoration: none; }
  .direct a:hover { color: var(--accent-on, var(--accent)); }
  .direct .loc { font-size: 12px; color: var(--muted-on, var(--muted)); margin-top: 6px; }
  /* Îlot clair sur la bande bleue : le formulaire garde des champs lisibles. */
  .form-wrap { border: 1px solid var(--rule, var(--hairline)); border-radius: var(--r); padding: 34px; }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 40px; }
    .form-wrap { padding: 24px; }
  }
</style>
