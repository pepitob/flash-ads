---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = "Mentions légales | Flash Ads";
const description = "Mentions légales de Flash Ads, agence de gestion Google Ads en Suisse romande.";
---

<BaseLayout title={title} description={description} path="/mentions-legales">
  <section class="legal">
    <div class="wrap">
      <span class="eyebrow">Informations légales</span>
      <h1 class="display">Mentions légales</h1>

      <p class="note mono">⚠️ PLACEHOLDER — compléter avec les informations légales réelles de l'entreprise (raison sociale, IDE/CHE, adresse, responsable de publication) avant publication.</p>

      <h2>Éditeur du site</h2>
      <p>
        {site.name}<br />
        {site.city} · {site.region} · Suisse<br />
        E-mail : <a href={`mailto:${site.email}`}>{site.email}</a><br />
        Numéro IDE (CHE-…) : <em>à compléter</em>
      </p>

      <h2>Responsable de la publication</h2>
      <p><em>Nom du responsable à compléter.</em></p>

      <h2>Hébergement</h2>
      <p>
        Site statique hébergé chez un fournisseur de pages statiques (Netlify, Vercel ou Cloudflare
        Pages). <em>Préciser l'hébergeur retenu et ses coordonnées.</em>
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        L'ensemble des contenus de ce site (textes, visuels, logo, code) est la propriété de
        {site.name}, sauf mention contraire. Toute reproduction sans autorisation est interdite.
      </p>

      <h2>Responsabilité</h2>
      <p>
        Les informations publiées le sont à titre indicatif et peuvent évoluer. {site.name} ne saurait
        être tenue responsable d'une utilisation des informations contraire à leur destination.
      </p>

      <p class="back"><a href="/">← Retour à l'accueil</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal { padding: 72px 0; }
  .legal h1 { font-size: clamp(32px, 4vw, 48px); font-weight: 600; margin: 16px 0 28px; }
  .legal h2 { font-family: var(--font-display); font-size: 21px; font-weight: 600; margin: 34px 0 10px; }
  .legal p { color: var(--ink); font-size: 16px; max-width: 60ch; line-height: 1.7; }
  .legal a { color: var(--flash-deep); }
  .note { background: #fff6d6; border: 1px solid #f0e0a0; border-radius: 10px; padding: 12px 16px; font-size: 12.5px; color: #6b5a1a; max-width: 60ch; }
  .back { margin-top: 40px; }
</style>
