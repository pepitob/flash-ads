---
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import Gtm from "../components/seo/Gtm.astro";
import FontPreload from "../components/seo/FontPreload.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { organizationSchema } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  /** JSON-LD spécifiques à la page (Service, FAQPage, Article, Breadcrumb…). */
  jsonLd?: Record<string, unknown>[];
  type?: "website" | "article";
}

const { title, description, path, image, noindex, jsonLd = [], type } = Astro.props;

// Organization injecté globalement + schémas spécifiques à la page.
const allSchemas = [organizationSchema(), ...jsonLd];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <Gtm part="head" />
    <FontPreload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEOHead
      title={title}
      description={description}
      path={path}
      image={image}
      noindex={noindex}
      jsonLd={allSchemas}
      type={type}
    />
  </head>
  <body>
    <Gtm part="body" />

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

  </body>
</html>
