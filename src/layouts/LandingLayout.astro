---
/**
 * Layout des landing pages du trafic payant (`/lp/...`).
 *
 * Même <head>, mêmes polices et même conteneur GTM que `BaseLayout`, mais sans
 * sortie : logo non cliquable, sans menu, un seul bouton dans l'en-tête (vers le
 * formulaire `#contact` de la page), pied de page réduit aux liens légaux et
 * aux coordonnées. Toujours `noindex, nofollow`,
 * sans aucun JSON-LD (pas même Organization), et exclu du sitemap
 * (`astro.config.mjs`) : la page indexée reste la page service.
 */
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import Gtm from "../components/seo/Gtm.astro";
import FontPreload from "../components/seo/FontPreload.astro";
import Brand from "../components/Brand.astro";
import GooglePartnerBadge from "../components/GooglePartnerBadge.astro";
import { site, nav } from "../data/site";
import { ui } from "../i18n/fr";
import { cta } from "../data/chatgpt-ads";

interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Gtm part="head" />
    <FontPreload />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEOHead title={title} description={description} path={path} noindex />
  </head>
  <body class="lp">
    <Gtm part="body" />
    <a href="#main" class="skip-link">{ui.nav.skipToContent}</a>

    <header class="lp-header">
      <div class="wrap">
        <Brand href={null} />
        <a href="#contact" class="btn btn-primary lp-header-cta" data-cta="header">{cta.label} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="lp-footer band band--night">
      <div class="wrap lp-foot">
        <div class="lp-foot-id">
          <Brand href={null} light />
          <div class="lp-foot-badge"><GooglePartnerBadge height={56} /></div>
        </div>
        <div class="lp-foot-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
        </div>
        <div class="lp-foot-legal">
          <span>© {year} {site.name}.</span>
          {nav.legal.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 10px 16px;
    font-size: 14px;
  }
  .skip-link:focus { left: 0; }

  .lp-header { background: var(--paper); border-bottom: 1px solid var(--hairline); }
  .lp-header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; padding-block: 8px; }
  /* Même gabarit que le bouton du header du site (48px de haut) ; le libellé
     ne passe jamais sur deux lignes. */
  .lp-header-cta { white-space: nowrap; line-height: 1.2; flex-shrink: 0; }
  .lp-header :global(.brand) { flex-shrink: 0; }
  @media (max-width: 900px) {
    .lp-header-cta { padding: 11px 18px; font-size: 14px; }
  }
  @media (max-width: 480px) {
    .lp-header-cta { padding: 9px 14px; font-size: 13.5px; }
  }
  /* Sous 360px, logo + bouton ne tiennent plus dans les gouttières de 32px. */
  @media (max-width: 360px) {
    .lp-header .wrap { padding-inline: 16px; }
    .lp-header-cta .arrow { display: none; }
  }

  .lp-footer { padding: 48px 0 32px; }
  .lp-foot { display: grid; grid-template-columns: 1fr auto; gap: 28px 48px; align-items: start; }
  .lp-foot-badge { margin-top: 16px; }
  /* Comme dans le pied de page du site : pas de cadre ni d'ombre sur midnight. */
  .lp-foot-badge :global(.gp-badge) { border: 0; box-shadow: none; background: none; padding: 0; }
  .lp-foot-links { display: flex; flex-direction: column; gap: 9px; font-size: 14px; }
  .lp-foot-links a, .lp-foot-legal a { color: #fff; text-decoration: none; opacity: .8; }
  .lp-foot-links a:hover, .lp-foot-legal a:hover { opacity: 1; text-decoration: underline; }
  .lp-foot-legal {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    color: var(--on-faint);
  }

  /* La barre d'action mobile (fixe, en bas) ne doit jamais masquer le pied de page. */
  @media (max-width: 767px) {
    body.lp { padding-bottom: 76px; }
    .lp-foot { grid-template-columns: 1fr; }
  }
</style>
