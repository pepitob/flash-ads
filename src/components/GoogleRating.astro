---
/**
 * Note moyenne Google Business Profile, liée à la fiche. Données dans
 * `src/data/temoignages.ts` (`googleReviews`) : un seul endroit à mettre à jour.
 * Utilisée par les témoignages de la home et par les heros des pages services.
 */
import { googleReviews } from "../data/temoignages";

const ratingFr = googleReviews.rating.toFixed(1).replace(".", ",");
---

<a class="g-rating" href={googleReviews.profileUrl} target="_blank" rel="noopener noreferrer">
  <span class="g-stars" aria-hidden="true">★★★★★</span>
  <span><strong>{ratingFr}</strong> sur {googleReviews.count} avis Google</span>
</a>

<style>
  .g-rating {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    color: var(--muted-on, var(--muted));
    text-decoration: none;
  }
  .g-rating strong { color: var(--on-strong, var(--ink)); font-family: var(--font-display); }
  /* Même jaune que les étoiles des cartes de témoignages. */
  .g-stars { color: #f5a623; font-size: 15px; letter-spacing: 2px; }
  .g-rating:hover { color: var(--on-strong, var(--ink)); }
</style>
