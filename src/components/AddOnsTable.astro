---
/**
 * Setup et add-ons - tableau sobre sous la grille tarifaire.
 * Lit src/data/tarifs.ts (source unique). Le setup tracking est obligatoire
 * avant tout lancement (tag rose) ; les autres lignes sont optionnelles.
 */
import { addOns } from "../data/tarifs";
---

<div class="addons edge">
  <h3>Mise en place et options</h3>
  <ul class="addons-list">
    {
      addOns.map((a) => (
        <li>
          <div class="addon-main">
            <span class="addon-label">
              {a.label}
              {a.mandatory && <span class="addon-tag">Obligatoire</span>}
            </span>
            <span class="addon-price">
              {a.price} <small>{a.unit === "une fois" ? "· une fois" : "/mois"}</small>
            </span>
          </div>
          {(a.availability || a.note) && (
            <p class="addon-note">
              {a.availability && <span>{a.availability}. </span>}
              {a.note}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .addons {
    max-width: 720px;
    margin: 44px auto 0;
    background: var(--surface-on, var(--paper));
    border-radius: var(--r);
    padding: 26px 28px;
  }
  .addons h3 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -.01em;
    margin-bottom: 6px;
  }
  .addons-list { list-style: none; margin: 0; padding: 0; }
  .addons-list li { padding: 14px 0; border-bottom: 1px solid var(--rule, var(--hairline)); }
  .addons-list li:first-child { border-top: 1px solid var(--rule, var(--hairline)); }
  .addon-main { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .addon-label {
    font-size: 14.5px;
    color: var(--on-strong, var(--ink));
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .addon-tag {
    font-family: var(--font-display);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--fa-pink);
    padding: 3px 7px;
    border-radius: 3px;
  }
  .addon-price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14.5px;
    color: var(--on-strong, var(--ink));
    white-space: nowrap;
  }
  .addon-price small { font-weight: 500; font-size: 12px; color: var(--muted-on, var(--muted)); }
  .addon-note { font-size: 12.5px; color: var(--muted-on, var(--muted)); margin-top: 5px; max-width: 44em; line-height: 1.55; }
</style>
