---
/**
 * Bloc CTA final. C'est la bande bleue de fin de page : le fond porte la
 * couleur, le bloc intérieur n'est plus une carte posée dessus.
 */
import { ui } from "../i18n/fr";

interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = "On en parle ? Le premier échange est gratuit.",
  text = "On regarde ensemble votre situation et on vous dit, simplement, ce qui est possible. Sans jargon, avec des prix fixes et publics. Et si vous savez déjà votre budget, choisissez votre pack directement.",
  primaryLabel = ui.cta.quote,
  primaryHref = "/contact",
  secondaryLabel = ui.cta.seePricing,
  secondaryHref = "/#tarifs",
} = Astro.props;
---

<section class="cta-section band band--night">
  <div class="wrap">
    <div class="final">
      <h2 class="display">{title}</h2>
      <p>{text}</p>
      <div class="cta-row">
        <a href={primaryHref} class="btn btn-primary">{primaryLabel} <span class="arrow" aria-hidden="true">→</span></a>
        {secondaryLabel && <a href={secondaryHref} class="btn btn-ghost">{secondaryLabel}</a>}
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section { text-align: center; }
</style>
