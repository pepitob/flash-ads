---
/**
 * Google Tag Manager, partagé par `BaseLayout` et `LandingLayout`.
 * `part="head"` : snippet en tête de <head> ; `part="body"` : <noscript> juste
 * après l'ouverture de <body>. Vider `site.gtmId` désactive tout le chargement.
 *
 * `is:inline` est indispensable : sans lui, Astro transformerait ce snippet en
 * module différé et il ne serait plus chargé en tête, ce que GTM demande.
 * `dataLayer` est aussi le canal des événements du site (calculateur,
 * formulaires, pages ChatGPT Ads).
 */
import { site } from "../../data/site";

interface Props {
  part: "head" | "body";
}
const { part } = Astro.props;
const id = site.gtmId;
// Chaînes construites ici : posées en ligne dans le gabarit, le compilateur
// Astro les découpe mal (gabarit littéral imbriqué dans un <script>).
const headSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${id}');`;
const bodySnippet = `<iframe src="https://www.googletagmanager.com/ns.html?id=${id}"
height="0" width="0" style="display:none;visibility:hidden"></iframe>`;
---

{id && part === "head" && <script is:inline set:html={headSnippet} />}
{id && part === "body" && <noscript set:html={bodySnippet} />}
