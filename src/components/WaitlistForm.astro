---
/**
 * Formulaire liste d'attente - page ChatGPT Ads (brief §6.3).
 * Distinct du formulaire de contact/audit. Endpoint via PUBLIC_FORMSPREE_WAITLIST_ID.
 * "Soyez prévenu et prioritaire dès l'ouverture en Suisse."
 */
import { ui } from "../i18n/fr";

const endpointId = import.meta.env.PUBLIC_FORMSPREE_WAITLIST_ID ?? "";
const action = endpointId ? `https://formspree.io/f/${endpointId}` : "";
---

<form class="wait-form" id="waitlist-form" method="POST" action={action} novalidate>
  {!endpointId && (
    <p class="form-warn">⚠️ Définissez <code>PUBLIC_FORMSPREE_WAITLIST_ID</code> dans <code>.env</code>.</p>
  )}
  <div class="row">
    <label class="sr-only" for="wl-email">{ui.form.email}</label>
    <input id="wl-email" type="email" name="email" required placeholder="vous@entreprise.ch" autocomplete="email" />
    <input type="text" name="entreprise" placeholder="Entreprise (optionnel)" autocomplete="organization" />
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="gotcha" aria-hidden="true" />
    <input type="hidden" name="liste" value="chatgpt-ads-suisse" />
    <button type="submit" class="btn btn-primary">{ui.form.submitWaitlist} <span class="arrow" aria-hidden="true">→</span></button>
  </div>
  <p class="wl-note mono">Pas de spam. Un seul e-mail : le jour où ChatGPT Ads ouvre en Suisse.</p>
  <p class="form-success" id="wl-success" hidden role="status">
    <strong>Vous êtes sur la liste.</strong> Vous serez prévenu·e en priorité dès l'ouverture en Suisse.
  </p>
  <p class="form-error" id="wl-error" hidden role="alert">Une erreur est survenue. Réessayez.</p>
</form>

<style>
  .wait-form { max-width: 640px; }
  .row { display: flex; gap: 12px; flex-wrap: wrap; }
  .row input[type="email"], .row input[type="text"]:not(.gotcha) {
    flex: 1 1 200px;
    font-family: var(--font-body);
    font-size: 15px;
    padding: 13px 16px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
  }
  .row input:focus { outline: none; border-color: var(--accent); box-shadow: var(--ring-accent); }
  .gotcha { position: absolute; left: -9999px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .wl-note { font-size: 12px; color: var(--muted); margin-top: 12px; }
  .form-success { background: rgba(37, 99, 255, .06); border-left: 3px solid var(--accent); border-radius: 12px; padding: 16px 18px; font-size: 15px; margin-top: 14px; }
  .form-error { color: #b00020; font-size: 14px; margin-top: 10px; }
  .form-warn { background: #fff6d6; border: 1px solid #f0e0a0; border-radius: 10px; padding: 10px 14px; font-size: 13px; margin-bottom: 12px; }
</style>

<script>
  const form = document.getElementById("waitlist-form") as HTMLFormElement | null;
  const ok = document.getElementById("wl-success");
  const err = document.getElementById("wl-error");
  if (form && form.action) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      err?.setAttribute("hidden", "");
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (res.ok) { form.reset(); (form.querySelector(".row") as HTMLElement).style.display = "none"; ok?.removeAttribute("hidden"); }
        else throw new Error("bad");
      } catch { err?.removeAttribute("hidden"); }
    });
  }
</script>
