---
/**
 * « Votre secteur peut-il diffuser ? » : trois cartes par statut, alimentées par
 * `chatgpt-secteurs.ts` (même source que le champ Secteur du formulaire).
 *
 * `interactive` ajoute un sélecteur au-dessus des cartes (landing page) : il met
 * la bonne carte en avant, affiche un message et pré-remplit le formulaire.
 * Sans JavaScript, le sélecteur reste masqué et les cartes se lisent seules.
 * Les messages sont rendus ici dans des blocs masqués : le script ne fait que les
 * cloner, aucun texte n'est écrit en dur côté client.
 */
import HeadSplit from "./HeadSplit.astro";
import { secteurGroupes, secteurAutre, preuveSante, openaiAdPolicies } from "../../data/chatgpt-secteurs";
import { cta, statusIcon } from "../../data/chatgpt-ads";

interface Props {
  band?: "paper" | "tint";
  interactive?: boolean;
}
const { band = "paper", interactive = false } = Astro.props;

const sectors = [...secteurGroupes.flatMap((g) => g.sectors), secteurAutre];

const messages = [
  {
    status: "ouvert",
    text: "Votre secteur peut diffuser sur ChatGPT. On vérifie votre offre précise lors du premier échange.",
  },
  {
    status: "validation",
    text: "Possible, après validation par OpenAI. Nous diffusons déjà pour un réseau de cabinets dentaires et d'orthodontie : on prépare le dossier avec vous.",
  },
  {
    status: "impossible",
    text: "Les règles d'OpenAI ne permettent pas la publicité pour ce secteur en Suisse aujourd'hui. Inutile de payer pour tester. Google Ads reste une option :",
  },
  { status: "autre", text: "Ça dépend de votre offre. On vérifie ensemble en 15 minutes." },
] as const;
---

<section id="secteurs" class:list={["band", `band--${band}`]}>
  <div class="wrap">
    <HeadSplit eyebrow="Qui peut diffuser" title={"Votre secteur peut-il diffuser sur ChatGPT\u00a0?"}>
      OpenAI n'accepte pas tous les secteurs. Mieux vaut le savoir avant de dépenser un franc.
    </HeadSplit>

    {interactive && (
      <div class="sect-picker" data-sect-picker hidden>
        <div class="picker-field">
          <label for="sect-select">Votre secteur</label>
          <select id="sect-select">
            <option value="">Choisir votre secteur</option>
            {sectors.map((s) => <option value={s.id}>{s.label}</option>)}
          </select>
        </div>
        <div class="sect-msg" aria-live="polite" data-sect-msg></div>
        {messages.map((m) => (
          <div class="msg-src" hidden data-msg={m.status}>
            <div class:list={["msg", `msg--${m.status}`]}>
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true" set:html={statusIcon[m.status]} />
              <div class="msg-body">
                <p>
                  {m.text}
                  {m.status === "impossible" && <Fragment>{" "}<a href="/#tarifs">voir nos packs Google Ads</a>.</Fragment>}
                </p>
                {m.status !== "impossible" && (
                  <a href="#contact" class="btn btn-primary">{cta.label} <span class="arrow" aria-hidden="true">→</span></a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="sect-grid" data-sect-grid>
      {secteurGroupes.map((g) => (
        <div class:list={["sect-card", `sect-card--${g.status}`]} data-status={g.status}>
          <h3>
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true" set:html={statusIcon[g.status]} />
            {g.title}
          </h3>
          <ul>
            {g.sectors.map((s) => <li data-id={s.id}>{s.label}</li>)}
          </ul>
          {g.status === "validation" && <p class="sect-proof">{preuveSante}</p>}
        </div>
      ))}
    </div>
    <div class="sect-foot">
      <p class="sect-note">
        ChatGPT n'affiche pas d'annonces à côté des conversations sur la santé personnelle ou la santé
        mentale : les thérapies sont donc peu adaptées.
        <a href={openaiAdPolicies} target="_blank" rel="noopener">Règles publicitaires d'OpenAI</a> au
        7 octobre 2026, susceptibles d'évoluer : on vérifie votre cas avant tout engagement.
      </p>
      {!interactive && (
        <a href="#contact" class="btn btn-primary">{cta.label} <span class="arrow" aria-hidden="true">→</span></a>
      )}
    </div>
  </div>
</section>

<style>
  .sect-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  /* Le statut se lit au filet supérieur ET à l'icône du titre : la couleur
     seule ne suffirait pas (daltonisme, impression en noir et blanc). */
  .sect-card { background: var(--surface-on, var(--paper)); border: 1px solid var(--rule, var(--hairline)); border-top: 4px solid var(--sect-c); border-radius: var(--r); padding: 26px; }
  .sect-card--ouvert { --sect-c: var(--accent-on, var(--accent)); }
  .sect-card--validation { --sect-c: var(--fa-pink); }
  .sect-card--impossible { --sect-c: var(--fa-slate); }
  .sect-card h3 { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 600; font-size: 18px; }
  .sect-card h3 svg { width: 24px; height: 24px; flex: 0 0 auto; stroke: var(--sect-c); }
  .sect-card ul { list-style: none; margin-top: 18px; }
  .sect-card li { font-size: 14.5px; color: var(--on, var(--body)); line-height: 1.45; padding: 8px 0; border-top: 1px solid var(--rule, var(--hairline)); }
  .sect-card--impossible li { color: var(--muted-on, var(--muted)); }
  .sect-proof { font-size: 14px; font-weight: 500; color: var(--on-strong, var(--ink)); margin-top: 18px; padding: 12px 14px; background: var(--fa-tint); border-radius: var(--r); }
  .sect-foot { display: flex; align-items: center; justify-content: space-between; gap: 24px 48px; margin-top: 32px; }
  .sect-note { font-size: 13.5px; color: var(--muted-on, var(--muted)); line-height: 1.6; max-width: 46em; }
  .sect-note a { color: var(--accent-on, var(--accent)); text-decoration: underline; text-underline-offset: 3px; }
  .sect-foot .btn { flex: 0 0 auto; }

  /* ── Sélecteur (landing page) ── */
  .sect-picker { display: grid; grid-template-columns: minmax(0, 380px) minmax(0, 1fr); gap: 20px 40px; align-items: start; margin-bottom: 32px; }
  .sect-picker[hidden] { display: none; }
  .picker-field { display: flex; flex-direction: column; gap: 8px; }
  .picker-field label { font-family: var(--font-display); font-size: 15px; font-weight: 600; color: var(--on-strong, var(--ink)); }
  .picker-field select {
    font-family: var(--font-body);
    font-size: 16px;
    padding: 13px 14px;
    border: var(--edge-w) solid var(--edge);
    border-radius: var(--r);
    background: var(--surface-on, var(--paper));
    color: var(--on-strong, var(--ink));
    width: 100%;
  }
  .picker-field select:focus-visible { outline: 3px solid var(--fa-pink); outline-offset: 3px; }
  .sect-msg:empty { display: none; }
  .sect-msg :global(.msg) { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; background: var(--surface-on, var(--paper)); border: 1px solid var(--rule, var(--hairline)); border-left: 4px solid var(--msg-c); border-radius: var(--r); }
  .sect-msg :global(.msg--ouvert) { --msg-c: var(--accent-on, var(--accent)); }
  .sect-msg :global(.msg--validation) { --msg-c: var(--fa-pink); }
  .sect-msg :global(.msg--impossible) { --msg-c: var(--fa-slate); }
  .sect-msg :global(.msg--autre) { --msg-c: var(--fa-navy); }
  .sect-msg :global(svg) { width: 24px; height: 24px; flex: 0 0 auto; stroke: var(--msg-c); margin-top: 1px; }
  .sect-msg :global(p) { font-size: 15px; line-height: 1.55; color: var(--on-strong, var(--ink)); }
  .sect-msg :global(p a) { color: var(--accent-on, var(--accent)); text-decoration: underline; text-underline-offset: 3px; font-weight: 500; }
  .sect-msg :global(.btn) { margin-top: 14px; }

  /* Carte du secteur choisi : trait plus épais et ombre décalée ; les autres
     s'effacent. Le secteur lui-même passe en gras (pas la couleur seule). */
  .sect-grid.has-pick .sect-card { transition: opacity .2s; }
  .sect-grid.has-pick .sect-card:not(.is-active) { opacity: .5; }
  .sect-card.is-active { border-left: 2px solid var(--edge); border-right: 2px solid var(--edge); border-bottom: 2px solid var(--edge); box-shadow: var(--shadow-edge); }
  .sect-card li.is-picked { font-weight: 700; color: var(--on-strong, var(--ink)); }

  @media (max-width: 900px) {
    .sect-grid { grid-template-columns: 1fr; }
    .sect-foot { flex-direction: column; align-items: flex-start; }
    .sect-picker { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sect-grid.has-pick .sect-card { transition: none; }
  }
</style>

<script>
  import { push, type Eligibilite } from "../../lib/lead-track";

  const picker = document.querySelector<HTMLElement>("[data-sect-picker]");
  const select = document.getElementById("sect-select") as HTMLSelectElement | null;
  const msg = document.querySelector<HTMLElement>("[data-sect-msg]");
  const grid = document.querySelector<HTMLElement>("[data-sect-grid]");

  if (picker && select && msg && grid) {
    picker.hidden = false;
    const cards = [...grid.querySelectorAll<HTMLElement>(".sect-card")];

    select.addEventListener("change", () => {
      const id = select.value;
      const li = grid.querySelector<HTMLElement>(`li[data-id="${CSS.escape(id)}"]`);
      const card = li?.closest<HTMLElement>(".sect-card") ?? null;
      const status = (card?.dataset.status || (id ? "autre" : "")) as Eligibilite | "";

      grid.classList.toggle("has-pick", Boolean(card));
      cards.forEach((c) => c.classList.toggle("is-active", c === card));
      grid.querySelectorAll("li.is-picked").forEach((l) => l.classList.remove("is-picked"));
      li?.classList.add("is-picked");

      msg.textContent = "";
      const tpl = status && picker.querySelector<HTMLElement>(`.msg-src[data-msg="${status}"]`);
      if (tpl) msg.append(...[...tpl.childNodes].map((n) => n.cloneNode(true)));

      // Pré-remplit le formulaire sans déclencher son propre `eligibility_check`.
      const formSelect = document.getElementById("chatgpt-secteur") as HTMLSelectElement | null;
      if (formSelect && id) {
        formSelect.value = id;
        formSelect.dispatchEvent(new CustomEvent("cgpt-prefill"));
      }

      if (status) push({ event: "eligibility_check", source: "selecteur", secteur: id, eligibilite: status });
    });
  }
</script>
