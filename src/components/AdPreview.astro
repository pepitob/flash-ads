---
/**
 * Aperçu d'annonce Google — visuel signature du hero (remplace le dashboard).
 * Montre concrètement le métier (une annonce Search bien faite) sans aucune
 * métrique à décoder. Le seul élément animé : le point "en direct".
 * Données/exemples illustratifs et configurables.
 */
interface Props {
  query?: string;
  domain?: string;
  headline?: string;
  description?: string;
  sitelinks?: string[];
}

const {
  query = "plombier genève urgence",
  domain = "votreplomberie.ch",
  headline = "Plombier à Genève — Intervention 24h/24",
  description =
    "Dépannage en 30 minutes dans tout le canton. Devis gratuit, prix annoncés à l'avance, sans surprise.",
  sitelinks = ["Urgences 24/7", "Nos tarifs", "Demander un devis"],
} = Astro.props;
---

<div class="ad reveal" role="img" aria-label={`Exemple d'annonce Google Search gérée par Flash Ads pour la recherche « ${query} »`}>
  <!-- Barre de recherche -->
  <div class="ad-search">
    <svg class="ad-loupe" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke-width="2" /><path d="M21 21l-4-4" stroke-width="2" stroke-linecap="round" /></svg>
    <span class="ad-query">{query}</span>
    <span class="ad-caret" aria-hidden="true"></span>
  </div>

  <!-- Résultat sponsorisé -->
  <div class="ad-result">
    <div class="ad-top">
      <span class="ad-tag">Annonce</span>
      <span class="ad-url">{domain}</span>
    </div>
    <h2 class="ad-title">{headline}</h2>
    <p class="ad-desc">{description}</p>
    <div class="ad-rating">
      <span class="stars" aria-hidden="true">★★★★★</span>
      <span class="ad-reviews">4,9 · Avis vérifiés</span>
    </div>
    <div class="ad-links">
      {sitelinks.map((s) => <span class="ad-link">{s}</span>)}
    </div>
  </div>

  <!-- Badge Flash Ads -->
  <div class="ad-foot">
    <span class="ad-brand">
      <span class="ad-bolt" aria-hidden="true"><svg viewBox="0 0 24 24" fill="#fff"><path d="M13 2L4.5 13.5H11l-1 8.5L19.5 10H13l0-8z" /></svg></span>
      Annonce gérée par Flash Ads
    </span>
    <span class="ad-live"><i aria-hidden="true"></i>en direct</span>
  </div>
</div>

<style>
  .ad {
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 22px;
    box-shadow: var(--shadow);
    padding: 18px;
    position: relative;
    overflow: hidden;
  }
  .ad::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(420px 180px at 85% -10%, rgba(37, 99, 255, .08), transparent 70%);
    pointer-events: none;
  }

  /* search bar */
  .ad-search {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    background: var(--surface-subtle);
    position: relative;
  }
  .ad-loupe { width: 17px; height: 17px; stroke: var(--muted); flex: 0 0 auto; }
  .ad-query { font-size: 15px; color: var(--ink); }
  .ad-caret {
    width: 1.5px; height: 17px; background: var(--accent); margin-left: -4px;
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* sponsored result */
  .ad-result { padding: 22px 14px 6px; position: relative; }
  .ad-top { display: flex; align-items: center; gap: 9px; margin-bottom: 7px; }
  .ad-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    color: var(--ink);
  }
  .ad-url { font-size: 13px; color: var(--muted); }
  .ad-url::before { content: ""; }
  .ad-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(19px, 2.2vw, 23px);
    letter-spacing: -.01em;
    line-height: 1.25;
    color: var(--accent);
  }
  .ad-desc { font-size: 14.5px; color: var(--muted); margin-top: 8px; max-width: 34em; }
  .ad-rating { display: flex; align-items: center; gap: 9px; margin-top: 12px; }
  .stars { color: #f5a623; font-size: 14px; letter-spacing: 1px; }
  .ad-reviews { font-size: 12.5px; color: var(--muted); }
  .ad-links { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 14px; }
  .ad-link { font-size: 13.5px; color: var(--accent); }

  /* foot badge */
  .ad-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding: 14px 14px 4px;
    border-top: 1px solid var(--hairline);
    position: relative;
  }
  .ad-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }
  .ad-bolt {
    width: 20px; height: 20px;
    display: grid; place-items: center;
    border-radius: 6px;
    background: var(--grad);
    box-shadow: var(--shadow-flash);
  }
  .ad-bolt svg { width: 11px; height: 11px; }
  .ad-live {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-display); font-size: 11px; font-weight: 600; color: var(--fa-pink);
    text-transform: uppercase; letter-spacing: .08em;
  }
  .ad-live i {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--fa-pink);
    box-shadow: 0 0 0 0 rgba(255, 46, 139, .5);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 46, 139, .45); }
    70% { box-shadow: 0 0 0 8px rgba(255, 46, 139, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 46, 139, 0); }
  }
</style>
