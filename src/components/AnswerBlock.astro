---
/**
 * Bloc de réponse directe (GEO) - 2-3 phrases factuelles extractibles par les
 * moteurs génératifs, sous un H2 formulé comme une question quand pertinent.
 * Brief §9. Placé en début de page service / article.
 */
interface Props {
  /** Question (devient le H2). Optionnel : si absent, pas de titre. */
  question?: string;
  /** Niveau de titre (default h2). */
  as?: "h2" | "h3";
  /**
   * `card` (défaut) : encadré, pour une réponse posée au fil d'un article.
   * `lead` : sans cadre, titre à gauche et réponse à droite, quand le bloc
   * ouvre une section et n'a donc rien à se détacher de.
   * `stack` : sans cadre, question puis réponse en pleine largeur, en chapô de
   * grand corps.
   */
  variant?: "card" | "lead" | "stack";
}
const { question, as = "h2", variant = "card" } = Astro.props;
const Heading = as;
---

<div class:list={["answer", variant]}>
  {question && <Heading class="answer-q display">{question}</Heading>}
  <div class="answer-body"><slot /></div>
</div>

<style>
  .answer {
    background: var(--surface-on, var(--paper));
    border: 1px solid var(--rule, var(--hairline));
    border-left: 3px solid var(--accent-on, var(--accent));
    border-radius: var(--r);
    padding: 26px 28px;
    margin: 8px 0 8px;
  }
  .answer-q { font-size: clamp(20px, 2.4vw, 26px); font-weight: 600; margin-bottom: 12px; }
  .answer-body :global(p) { font-size: 17px; color: var(--on-strong, var(--ink)); }
  .answer-body :global(p + p) { margin-top: 10px; }
  .answer-body :global(b) { color: var(--on-strong, var(--ink)); }

  /* Variante d'ouverture de section : pas de cadre, la question tient lieu de
     titre et la réponse se lit comme un chapô, sur deux colonnes. */
  .answer.lead {
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    gap: 56px;
    align-items: start;
  }
  .answer.lead .answer-q {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 700;
    letter-spacing: -.02em;
    margin-bottom: 0;
  }
  .answer.lead .answer-body :global(p) { font-size: 18px; line-height: 1.75; }

  /* Variante empilée : la question tient lieu de titre de section, la réponse
     suit en pleine largeur, en chapô de grand corps. */
  .answer.stack { background: none; border: 0; padding: 0; margin: 0; }
  .answer.stack .answer-q { font-size: clamp(28px, 3.4vw, 42px); font-weight: 700; letter-spacing: -.02em; margin: 14px 0 0; }
  .answer.stack .answer-body { margin-top: 24px; }
  .answer.stack .answer-body :global(p) { font-size: clamp(19px, 1.9vw, 23px); line-height: 1.6; color: var(--on, var(--body)); text-wrap: pretty; }
  .answer.stack .answer-body :global(b) { color: var(--on-strong, var(--ink)); font-weight: 600; }

  @media (max-width: 900px) {
    .answer.lead { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 640px) {
    .answer.stack .answer-body { margin-top: 18px; }
  }
</style>
