---
/**
 * Calculateur de budget Google Ads (îlot interactif).
 *
 * Un seul composant, deux habillages : `variant="full"` (page dédiée) et
 * `variant="compact"` (section intégrée à une page existante, avec lien vers
 * la version complète). Un seul moteur : src/lib/calculator.ts, appelé ici au
 * build pour rendre l'état par défaut en HTML statique (référencement + aucun
 * layout shift + résultat lisible sans JavaScript), puis repris par le script
 * client au recalcul (aucun bouton « Calculer », tout est instantané).
 *
 * Mise en page : `.calc-main` porte la grille deux colonnes et sert de bloc
 * conteneur au `position: sticky` de la carte résultat. Le disclaimer et le
 * bloc « Comment ce calcul fonctionne » sont HORS de cette grille, sinon la
 * carte glisserait par-dessus eux au scroll.
 *
 * Mode expert : ?pro=1 dans l'URL ou le bouton discret en bas du calculateur.
 * Il déverrouille les hypothèses (CPC, taux, marge, LTV) pour construire le
 * chiffre en direct devant un prospect. Non indexé : la page pose son canonique
 * sans paramètre.
 */
import {
  sectors,
  defaultInput,
  compute,
  resultCopy,
  assumptionsCopy,
  disclaimerShort,
  cpaLine,
  params,
  fmt,
  fmtDec,
} from "../../lib/calculator";
import { pricingNotes } from "../../data/tarifs";
import FieldTip from "./FieldTip.astro";

interface Props {
  variant?: "full" | "compact";
  /** Lien « Version complète » (variante compacte uniquement). */
  fullHref?: string;
}
const { variant = "full", fullHref = "/calculateur-budget" } = Astro.props;

const input = defaultInput();
const result = compute(input);
const copy = resultCopy(input, result);
const assumptions = assumptionsCopy(input, result);
const expertCpa = cpaLine(result);
const roasDerived = Math.round((100 / input.margePct) * 10) / 10;
const tier = result.tier;
const packHref = tier ? tier.stripeLink || `/contact?pack=${tier.id}` : "/contact";
---

<div class:list={["calc", variant]} data-calc data-variant={variant}>
  <div class="calc-main">
    <form class="calc-form" novalidate autocomplete="off">
      <!-- Type d'activité : branchement lead-gen / e-commerce -->
      <fieldset class="field">
        <legend class="lbl">Quel type d'activité ?</legend>
        <div class="pills" role="radiogroup">
          <label class="pill">
            <input type="radio" name="activity" value="leadgen" checked />
            <span>Services / génération de leads</span>
          </label>
          <label class="pill">
            <input type="radio" name="activity" value="ecommerce" />
            <span>Boutique en ligne</span>
          </label>
        </div>
      </fieldset>

      <!-- Secteur : modèle leads uniquement (l'e-commerce raisonne en marge) -->
      <div class="field" data-when="leadgen">
        <label class="lbl" for="calc-sector">
          Secteur d'activité
          <FieldTip id="tip-sector" label="secteur d'activité">
            Le secteur détermine le coût par clic moyen observé en Suisse romande.
          </FieldTip>
        </label>
        <select id="calc-sector" name="sector">
          {sectors.map((s) => (
            <option value={s.id} selected={s.id === input.sector}>{s.label}</option>
          ))}
        </select>
      </div>

      <!-- ── Modèle lead-gen : deux questions, aucune hypothèse exposée ── -->
      <div data-when="leadgen">
        <div class="field">
          <label class="lbl" for="calc-clients">
            Nouveaux clients souhaités par mois
            <FieldTip id="tip-clients" label="nombre de clients souhaités">
              Combien de clients supplémentaires par mois rendraient cet investissement intéressant.
            </FieldTip>
            <output class="val" data-out="clients-val">{input.clients}</output>
          </label>
          <input id="calc-clients" name="clients" type="range" min={params.clientsMin} max={params.clientsMax} step="1" value={input.clients} />
          <div class="scale"><span>{params.clientsMin}</span><span>{params.clientsMax}</span></div>
        </div>

      </div>

      <!-- ── Modèle e-commerce ── -->
      <div data-when="ecommerce" hidden>
        <div class="field">
          <label class="lbl" for="calc-basket">
            Panier moyen (CHF)
            <FieldTip id="tip-basket" label="panier moyen">
              Le montant moyen d'une commande sur votre boutique.
            </FieldTip>
          </label>
          <input id="calc-basket" name="basket" type="number" min="1" step="5" inputmode="numeric" value={input.basket} />
        </div>

        <div class="field">
          <label class="lbl" for="calc-marge-pct">
            Marge brute (%)
            <FieldTip id="tip-marge-pct" label="marge brute">
              Ce qui vous reste après le coût des produits, avant frais fixes.
            </FieldTip>
          </label>
          <!-- Champ chiffré et curseur pilotent la même valeur : le champ rend la
               marge lisible et saisissable au clavier, le curseur reste pour explorer. -->
          <div class="pair">
            <div class="pair-num">
              <input id="calc-marge-pct" name="margePct" type="number" min={params.margePctMin} max={params.margePctMax} step="1" inputmode="numeric" value={input.margePct} />
              <span class="pair-unit" aria-hidden="true">%</span>
            </div>
            <input
              name="margePctRange"
              type="range"
              min={params.margePctMin}
              max={params.margePctMax}
              step="1"
              value={input.margePct}
              aria-label="Marge brute, curseur"
            />
          </div>
          <div class="scale"><span>{params.margePctMin}%</span><span>{params.margePctMax}%</span></div>
          <p class="hint" data-out="roas-hint">{`Avec une marge de ${fmt(input.margePct)}%, chaque franc de publicité doit générer au moins ${fmtDec(100 / input.margePct)} francs de ventes pour rentrer dans vos frais.`}</p>
        </div>

        <div class="field">
          <label class="lbl" for="calc-orders">
            Commandes supplémentaires souhaitées par mois
            <FieldTip id="tip-orders" label="commandes souhaitées">
              Les commandes que la publicité doit générer en plus chaque mois, au-delà de vos ventes actuelles.
            </FieldTip>
          </label>
          <div class="pair">
            <div class="pair-num bare">
              <input id="calc-orders" name="orders" type="number" min={params.ordersMin} max={params.ordersMax} step="1" inputmode="numeric" value={input.orders} />
            </div>
            <input
              name="ordersRange"
              type="range"
              min={params.ordersMin}
              max={params.ordersMax}
              step="1"
              value={input.orders}
              aria-label="Commandes supplémentaires par mois, curseur"
            />
          </div>
          <div class="scale"><span>{params.ordersMin}</span><span>{params.ordersMax}</span></div>
          <p class="hint" data-out="revenue-hint">{`Soit ${fmt(input.orders * input.basket)} CHF de ventes supplémentaires par mois.`}</p>
        </div>
      </div>

      <!-- ── Mode expert : hypothèses déverrouillées ── -->
      <div class="expert" data-expert hidden>
        <p class="expert-head">Hypothèses du calcul</p>

        <div data-when="leadgen">
          <!-- Valeur d'un client : sert au seul contrôle de rentabilité, jamais au budget -->
          <div class="field">
            <label class="lbl" for="calc-value" data-out="value-label">
              Valeur d'un nouveau client (CHF)
              <FieldTip id="tip-value" label="valeur d'un nouveau client" dataOut="value-tip">
                Ce qu'un client typique vous rapporte en chiffre d'affaires. Pour un client récurrent, comptez la première année.
              </FieldTip>
            </label>
            <input id="calc-value" name="clientValue" type="number" min="1" step="10" inputmode="numeric" placeholder="Laissez vide pour ne pas contrôler" value={input.clientValue || ""} />
          </div>

          <div class="field">
            <span class="lbl" id="lbl-type-client">
              Type de client
              <FieldTip id="tip-recurring" label="type de client">
                Un client ponctuel achète une fois, un client récurrent revient. La valeur à vie change alors la lecture de la rentabilité, pas le budget.
              </FieldTip>
            </span>
            <div class="pills small" role="radiogroup" aria-labelledby="lbl-type-client">
              <label class="pill">
                <input type="radio" name="recurring" value="0" checked />
                <span>Client ponctuel</span>
              </label>
              <label class="pill">
                <input type="radio" name="recurring" value="1" />
                <span>Client récurrent</span>
              </label>
            </div>
          </div>

          <!-- Bloc valeur à vie : uniquement si le client est récurrent -->
          <div class="sub" data-when="recurring" hidden>
            <div class="row2">
              <div class="field">
                <label class="lbl" for="calc-purchases">
                  Achats par an
                  <FieldTip id="tip-purchases" label="achats par an">
                    Combien de fois un client type achète ou fait appel à vous sur une année.
                  </FieldTip>
                </label>
                <input id="calc-purchases" name="purchasesPerYear" type="number" min="1" step="1" inputmode="numeric" value={input.purchasesPerYear} />
              </div>
              <div class="field">
                <label class="lbl" for="calc-loyalty">
                  Durée de fidélité (années)
                  <FieldTip id="tip-loyalty" label="durée de fidélité">
                    Combien d'années un client type reste chez vous avant de partir.
                  </FieldTip>
                  <output class="val" data-out="loyalty-val">{input.loyaltyYears}</output>
                </label>
                <input id="calc-loyalty" name="loyaltyYears" type="range" min={params.loyaltyYearsMin} max={params.loyaltyYearsMax} step="1" value={input.loyaltyYears} />
              </div>
            </div>
            <p class="ltv">Valeur à vie estimée d'un client : <b data-out="ltv">0 CHF</b></p>
          </div>

          <div class="row2">
            <div class="field">
              <label class="lbl" for="calc-cpcmin">
                CPC min (CHF)
                <FieldTip id="tip-cpcmin" label="coût par clic minimum">
                  Coût par clic : ce que Google facture à chaque visite amenée par une annonce. Ici la borne basse de votre secteur, sur les recherches peu disputées.
                </FieldTip>
              </label>
              <input id="calc-cpcmin" name="cpcMin" type="number" min="0.1" step="0.1" value={input.cpcMin} />
            </div>
            <div class="field">
              <label class="lbl" for="calc-cpcmax">
                CPC max (CHF)
                <FieldTip id="tip-cpcmax" label="coût par clic maximum">
                  La borne haute de votre secteur, sur les mots-clés les plus disputés. Le budget recommandé se calcule sur le coût central entre les deux.
                </FieldTip>
              </label>
              <input id="calc-cpcmax" name="cpcMax" type="number" min="0.1" step="0.1" value={input.cpcMax} />
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label class="lbl" for="calc-conv">
                Conversion du site (%)
                <FieldTip id="tip-conv" label="taux de conversion du site">
                  Part des visiteurs qui vous laissent une demande. 5 % veut dire 5 demandes pour 100 visites amenées par la publicité.
                </FieldTip>
              </label>
              <input id="calc-conv" name="conv" type="number" min="0.1" step="0.1" value={Math.round(input.conv * 1000) / 10} />
            </div>
            <div class="field">
              <label class="lbl" for="calc-closing">
                Taux de closing (%)
                <FieldTip id="tip-closing" label="taux de closing">
                  Part des demandes reçues qui deviennent des clients. 50 % veut dire un client signé pour deux demandes.
                </FieldTip>
              </label>
              <input id="calc-closing" name="closing" type="number" min="1" step="1" value={Math.round(input.closing * 100)} />
            </div>
          </div>
          <div class="row2">
            <div class="field">
              <label class="lbl" for="calc-marge">
                Marge sur la valeur client (%)
                <FieldTip id="tip-marge" label="marge sur la valeur client">
                  Ce qu'il vous reste sur la valeur d'un client une fois vos coûts déduits. C'est cette marge qui doit couvrir le coût d'acquisition, pas le chiffre d'affaires.
                </FieldTip>
              </label>
              <input id="calc-marge" name="marge" type="number" min="1" max="100" step="1" value={Math.round(input.marge * 100)} />
            </div>
            <div class="field">
              <label class="lbl" for="calc-safety">
                Facteur de sécurité
                <FieldTip id="tip-safety" label="facteur de sécurité">
                  Marge de prudence ajoutée au budget : les premières semaines coûtent toujours plus cher que la vitesse de croisière.
                </FieldTip>
              </label>
              <input id="calc-safety" name="safety" type="number" min="1" max="2" step="0.05" value={input.safety} />
            </div>
          </div>
          <div class="field">
            <label class="lbl" for="calc-zone">
              Zone principale
              <FieldTip id="tip-zone" label="zone principale">
                La concurrence publicitaire est plus forte dans les grandes agglomérations, ce qui renchérit le clic de 15 %.
              </FieldTip>
            </label>
            <select id="calc-zone" name="urban">
              <option value="0" selected>Reste de la Suisse romande</option>
              <option value="1">Grandes agglomérations (Genève, Lausanne)</option>
            </select>
          </div>
          <p class="expert-cpa" data-out="expert-cpa">{expertCpa}</p>
        </div>

        <div data-when="ecommerce" hidden>
          <div class="field">
            <label class="lbl" for="calc-roas">
              ROAS imposé
              <FieldTip id="tip-roas" label="ROAS imposé">
                Le curseur affiche le ROAS que votre marge impose. Le déplacer vous permet de fixer votre propre objectif et de voir aussitôt ce qu'il change au budget. Dès que vous modifiez la marge, il revient sur la valeur déduite.
              </FieldTip>
              <output class="val" data-out="roas-override-val">{fmtDec(roasDerived)} (déduit de la marge)</output>
            </label>
            <input id="calc-roas" name="roasOverride" type="range" min={params.roasMin} max={params.roasMax} step="0.1" value={roasDerived} />
            <div class="scale"><span>{params.roasMin}</span><span>{params.roasMax}</span></div>
          </div>
          <div class="field">
            <label class="lbl" for="calc-repeat">
              Taux de réachat annuel (%)
              <FieldTip id="tip-repeat" label="taux de réachat annuel">
                Part de vos clients qui recommandent dans l'année. Plus ils reviennent, plus un ROAS de campagne bas reste tenable.
              </FieldTip>
            </label>
            <input id="calc-repeat" name="repeatRate" type="number" min="0" max="200" step="5" value={Math.round(input.repeatRate * 100)} />
          </div>
        </div>

        <button type="button" class="reset" data-reset>Réinitialiser sur les valeurs du secteur</button>
      </div>

      <button type="button" class="expert-toggle" data-expert-toggle aria-expanded="false">
        <span data-out="expert-label">Mode expert</span>
      </button>
    </form>

    <!-- ── Résultat ── -->
    <aside class="calc-result" data-result>
      <!-- Cadrage : l'ordre de grandeur du marché avant que le montant tombe -->
      <p class="anchor" data-out="anchor">{copy.anchor}</p>

      <span class="eyebrow" data-out="eyebrow">Budget publicitaire recommandé</span>

      <p class="amount">
        <span class="flash-word" data-out="reco">{fmt(result.budgetReco)}</span>
        <span class="unit">CHF/mois</span>
      </p>
      <p class="band" data-out="band">{copy.band}</p>

      <!-- Détail chiffré : mode expert uniquement. Le calculateur public s'en
           tient au budget, pour ne pas multiplier les chiffres à retenir. -->
      <div class="figures" data-when="expert-only" hidden>
        <div class="fig" data-row="cost" hidden={!copy.costValue}>
          <span class="fig-k" data-out="cost-label">{copy.costLabel}</span>
          <span class="fig-v" data-out="cost-value">{copy.costValue}</span>
        </div>
        <p class="fig-note" data-out="cost-allin" hidden={!copy.costAllIn}>{copy.costAllIn}</p>
        <div class="fig" data-row="revenue" hidden={!copy.revenueValue}>
          <span class="fig-k">Chiffre d'affaires généré</span>
          <span class="fig-v" data-out="revenue-value">{copy.revenueValue}</span>
        </div>
        <div class="fig" data-row="roi" hidden={!copy.roiValue}>
          <span class="fig-k">Retour</span>
          <span class="fig-v" data-out="roi-value">{copy.roiValue}</span>
        </div>
        <p class="fig-note" data-out="marge-line" hidden={!copy.margeLine}>{copy.margeLine}</p>
      </div>

      <p class="source" data-out="source">{copy.source}</p>

      <p class="msg" data-msg data-tone={copy.tone} hidden={copy.tone === "none"}>{copy.message}</p>

      <!-- Pack recommandé : dérivé du seul chiffre recommandé, donc toujours aligné -->
      <div class="pack" data-pack hidden={!tier}>
        <div class="pack-top">
          <span class="pack-tier" data-out="pack-name">{tier?.name}</span>
          <span class="pack-price" data-out="pack-price">{tier ? `${tier.price}${tier.unit}` : ""}</span>
        </div>
        <p class="pack-line" data-out="pack-line">{copy.packLine}</p>
        <a class="btn btn-primary pack-cta" href={packHref} data-out="pack-cta" data-pack-cta>
          {tier?.ctaLabel}<span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="pack-overflow" data-out="pack-overflow" hidden={!copy.packOverflow}>{copy.packOverflow}</p>
        <p class="pack-note">{pricingNotes.budgetSeparate}</p>
      </div>

      {variant === "compact" && (
        <a class="full-link" href={fullHref}>Version complète du calculateur de budget<span class="arrow" aria-hidden="true">→</span></a>
      )}

      <p class="sr-only" role="status" aria-live="polite" data-out="live">{copy.live}</p>
    </aside>
  </div>

  <p class="disclaimer">{disclaimerShort}</p>

  <!-- Explication du calcul : transparence + signal GEO -->
  <details class="how">
    <summary>Comment ce calcul fonctionne</summary>
    <div class="how-body">
      <p>
        Les coûts par clic viennent des prévisions d'enchères de Google (Keyword Planner, août 2026),
        croisées avec les données agrégées et anonymisées des comptes que nous gérons en Suisse romande
        sur 12 mois. Rien n'est inventé, et rien n'est promis : ce sont des ordres de grandeur.
      </p>
      <p>
        Le raisonnement est simple. Pour signer un client, il faut plusieurs demandes entrantes (tout
        le monde ne signe pas). Pour obtenir une demande, il faut plusieurs visites sur votre site
        (tout le monde ne remplit pas le formulaire). Chaque visite est un clic payé à Google. On
        remonte cette chaîne à l'envers depuis votre objectif de clients, on multiplie par le coût
        central du clic dans votre secteur, et on ajoute une marge de sécurité de {fmtDec(params.safety)}
        parce que les premières semaines coûtent toujours plus cher que la vitesse de croisière.
      </p>
      <p>
        La rentabilité, elle, ne se juge pas sur le chiffre d'affaires d'un client mais sur la marge
        qu'il vous laisse : c'est elle qui doit couvrir le coût d'acquisition.
      </p>
      <p data-out="assumptions">{assumptions}</p>
      <p>
        Ces hypothèses sont des moyennes de secteur. Le mode expert, en bas du calculateur, permet de
        les remplacer par vos chiffres réels si vous les connaissez.
      </p>
    </div>
  </details>
</div>

<style>
  /* Les blocs masqués (modèle inactif, panneau expert) portent [hidden] :
     il doit gagner sur les display: flex/grid déclarés plus bas. */
  .calc [hidden] { display: none !important; }

  .calc { display: flex; flex-direction: column; gap: 24px; }
  /* La grille est le bloc conteneur du sticky : le disclaimer et le bloc
     « Comment ce calcul fonctionne » restent en dehors, sinon la carte
     résultat glisserait par-dessus eux au scroll. */
  .calc-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  /* ── Formulaire ── */
  .calc-form {
    background: var(--surface-on, var(--paper));
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--radius-xl);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .field { display: flex; flex-direction: column; gap: 8px; border: 0; padding: 0; margin: 0; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .lbl {
    position: relative; /* ancre des bulles d'aide (FieldTip.astro) */
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--on-strong, var(--ink));
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0;
  }
  .val {
    margin-left: auto;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--accent-on, var(--accent));
    font-variant-numeric: tabular-nums;
  }
  select, input[type="number"] {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 11px 13px;
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--radius-md);
    background: var(--surface-on, var(--paper));
    color: var(--on-strong, var(--ink));
    width: 100%;
  }
  select:focus, input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: var(--ring-accent);
  }
  .scale {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--on-faint, var(--faint));
    margin-top: -2px;
  }

  /* Slider : cible tactile confortable */
  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 26px;
    background: transparent;
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-runnable-track { height: 5px; border-radius: 999px; background: var(--fa-smoke); }
  input[type="range"]::-moz-range-track { height: 5px; border-radius: 999px; background: var(--fa-smoke); }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 22px; height: 22px; margin-top: -8.5px;
    border-radius: 50%; background: var(--accent);
    border: 3px solid #fff;
  }
  input[type="range"]::-moz-range-thumb {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--accent); border: 3px solid #fff;
  }
  input[type="range"]:focus-visible { outline: none; }
  input[type="range"]:focus-visible::-webkit-slider-thumb { box-shadow: var(--ring-accent); }
  input[type="range"]:focus-visible::-moz-range-thumb { box-shadow: var(--ring-accent); }

  /* Pills (type d'activité, ponctuel / récurrent) */
  .pills { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .pill { position: relative; }
  .pill input { position: absolute; opacity: 0; width: 0; height: 0; }
  .pill span {
    display: block;
    text-align: center;
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 600;
    padding: 11px 10px;
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--radius-md);
    color: var(--muted-on, var(--muted));
    cursor: pointer;
    transition: border-color var(--dur-normal) var(--ease-out), color var(--dur-normal) var(--ease-out), background var(--dur-normal) var(--ease-out);
  }
  .pill input:checked + span { border-color: var(--accent); color: var(--accent-on, var(--accent)); background: rgba(37, 99, 255, .06); }
  .pill input:focus-visible + span { box-shadow: var(--ring-accent); }
  .pills.small span { font-size: 12.5px; padding: 9px; }

  /* Bloc récurrent + mode expert */
  .sub, .expert {
    background: var(--surface-subtle);
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .expert > div { display: flex; flex-direction: column; gap: 14px; }
  .expert-head {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--on-faint, var(--faint));
  }
  .ltv { font-size: 13.5px; color: var(--on, var(--body)); }
  .hint { font-size: 12.5px; color: var(--muted-on, var(--muted)); line-height: 1.5; }

  /* Couple champ chiffré + curseur, pour une valeur à la fois lisible et explorable */
  .pair { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 14px; align-items: center; }
  .pair-num { position: relative; }
  .pair-num input {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    text-align: right;
    padding: 10px 26px 10px 10px;
    color: var(--accent-on, var(--accent));
  }
  .pair-num input::-webkit-outer-spin-button,
  .pair-num input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pair-num input { -moz-appearance: textfield; appearance: textfield; }
  .pair-num.bare input { padding-right: 10px; }
  .pair-unit {
    position: absolute;
    right: 11px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--accent-on, var(--accent));
    pointer-events: none;
  }
  @media (max-width: 480px) {
    .pair { grid-template-columns: 84px minmax(0, 1fr); gap: 10px; }
  }
  .expert-cpa {
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--accent-on, var(--accent));
    background: rgba(37, 99, 255, .06);
    border-radius: var(--radius-md);
    padding: 9px 12px;
    line-height: 1.5;
  }

  .ltv b { font-family: var(--font-display); color: var(--on-strong, var(--ink)); }
  .reset {
    align-self: flex-start;
    background: none; border: 0; padding: 0;
    font-family: var(--font-display); font-size: 12.5px; font-weight: 600;
    color: var(--accent-on, var(--accent)); cursor: pointer; text-decoration: underline;
  }
  .expert-toggle {
    align-self: flex-start;
    background: none; border: 0; padding: 4px 0;
    font-family: var(--font-display); font-size: 12.5px; font-weight: 600;
    color: var(--muted-on, var(--muted)); cursor: pointer;
  }
  .expert-toggle:hover, .expert-toggle:focus-visible { color: var(--accent-on, var(--accent)); }

  /* ── Résultat ── */
  .calc-result {
    background: var(--surface-on, var(--paper));
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--radius-xl);
    padding: 28px;
    position: sticky;
    top: 96px;
    /* Filet de sécurité : une carte plus haute que l'écran reste consultable. */
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }
  .amount {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(38px, 5.2vw, 52px);
    letter-spacing: -.03em;
    line-height: 1.05;
    margin-top: 12px;
    font-variant-numeric: tabular-nums;
  }
  .amount .unit { display: block; font-size: 14px; font-weight: 500; letter-spacing: 0; color: var(--muted-on, var(--muted)); margin-top: 6px; }
  .band {
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--on, var(--body));
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--rule, var(--hairline-subtle));
    font-variant-numeric: tabular-nums;
  }
  .anchor {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--on, var(--body));
    background: var(--surface-subtle);
    border-radius: var(--radius-md);
    padding: 10px 13px;
    margin-bottom: 18px;
  }

  /* Bloc chiffré du mode expert : un libellé à gauche, une valeur à droite. */
  .figures {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--rule, var(--hairline));
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .fig { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .fig-k { font-size: 13.5px; color: var(--muted-on, var(--muted)); }
  .fig-v {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--on-strong, var(--ink));
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .fig-note { font-size: 12.5px; color: var(--muted-on, var(--muted)); line-height: 1.5; margin-top: -4px; }

  .source { font-size: 12px; color: var(--on-faint, var(--faint)); line-height: 1.5; margin-top: 16px; }
  .msg {
    font-size: 14px;
    line-height: 1.6;
    border-radius: var(--radius-lg);
    padding: 14px 16px;
    margin-top: 16px;
    background: var(--surface-subtle);
    border: 1px solid var(--rule, var(--hairline));
    border-left: 3px solid var(--muted);
    color: var(--on, var(--body));
  }
  .msg[data-tone="warn"] { border-left-color: var(--fa-pink); background: rgba(255, 46, 139, .05); }
  .msg[data-tone="stop"] { border-left-color: var(--ink); background: var(--surface-subtle); }

  .pack {
    margin-top: 20px;
    border: 1px solid var(--rule, var(--hairline));
    border-radius: var(--radius-lg);
    padding: 18px;
  }
  .pack-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .pack-tier {
    font-family: var(--font-display);
    font-size: 11px; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--on-faint, var(--faint));
  }
  .pack-price { font-family: var(--font-display); font-weight: 700; font-size: 22px; letter-spacing: -.02em; color: var(--on-strong, var(--ink)); }
  .pack-line { font-size: 13.5px; color: var(--on, var(--body)); margin-top: 10px; }
  .pack-cta { width: 100%; margin-top: 14px; }
  .pack-overflow { font-size: 12px; color: var(--on, var(--body)); margin-top: 12px; line-height: 1.5; }
  .pack-note { font-size: 11.5px; color: var(--muted-on, var(--muted)); margin-top: 12px; line-height: 1.5; }
  .full-link {
    display: inline-flex; align-items: center; gap: 7px;
    margin-top: 16px;
    font-family: var(--font-display); font-size: 13.5px; font-weight: 600;
    color: var(--accent-on, var(--accent)); text-decoration: none;
  }
  .full-link:hover .arrow { transform: translateX(3px); }
  .full-link .arrow { transition: transform .18s ease; }

  .disclaimer { font-size: 11.5px; color: var(--muted-on, var(--muted)); line-height: 1.6; max-width: 80ch; }

  /* ── Explication ── */
  .how { border-top: 1px solid var(--rule, var(--hairline)); padding-top: 18px; }
  .how summary {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-on, var(--accent));
  }
  .how summary::-webkit-details-marker { display: none; }
  .how summary::after { content: " +"; }
  .how[open] summary::after { content: " –"; }
  .how summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 4px; }
  .how-body { margin-top: 14px; display: flex; flex-direction: column; gap: 12px; max-width: 68ch; }
  .how-body p { font-size: 14.5px; color: var(--muted-on, var(--muted)); }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* Variante compacte : une colonne plus dense, tient dans une section */
  .calc.compact .calc-form, .calc.compact .calc-result { padding: 22px; }
  .calc.compact .calc-result { position: static; max-height: none; }
  .calc.compact .amount { font-size: clamp(32px, 4.2vw, 40px); }
  .calc.compact .disclaimer { display: none; }

  @media (max-width: 900px) {
    .calc-main { grid-template-columns: 1fr; }
    .calc-result { position: static; max-height: none; overflow: visible; }
  }
  @media (max-width: 480px) {
    .calc-form, .calc-result { padding: 20px; }
    .row2 { grid-template-columns: 1fr; }
    .pills { grid-template-columns: 1fr; }
  }
</style>

<script>
  import {
    applySector,
    compute,
    defaultInput,
    resultCopy,
    assumptionsCopy,
    cpaLine,
    getSector,
    zoneCpc,
    params,
    fmt,
    fmtDec,
    type CalcInput,
  } from "../../lib/calculator";
  import { tiers } from "../../data/tarifs";

  /** Événements analytics, sans dépendance à un outil précis (dataLayer + CustomEvent). */
  function track(event: string, payload: Record<string, unknown> = {}) {
    const w = window as unknown as { dataLayer?: unknown[] };
    w.dataLayer = w.dataLayer || [];
    w.dataLayer.push({ event, ...payload });
    document.dispatchEvent(new CustomEvent("flashads:analytics", { detail: { event, ...payload } }));
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-calc]").forEach((root) => {
    const form = root.querySelector<HTMLFormElement>(".calc-form");
    if (!form) return;

    const out = (key: string) => root.querySelector<HTMLElement>(`[data-out="${key}"]`);
    const field = <T extends HTMLElement>(name: string) => form.querySelector<T>(`[name="${name}"]`);
    const num = (name: string, fallback: number) => {
      const el = field<HTMLInputElement>(name);
      const v = el ? Number(el.value) : NaN;
      return Number.isFinite(v) && v > 0 ? v : fallback;
    };
    const setText = (key: string, value: string) => {
      const el = out(key);
      if (el) el.textContent = value;
    };

    let state: CalcInput = defaultInput();
    let expert = false;
    let started = false;
    // Le curseur ROAS du mode expert affiche par défaut le ROAS déduit de la
    // marge. Il ne devient une surcharge qu'une fois déplacé à la main, et il
    // repasse en mode déduit dès que la marge brute change.
    let roasTouched = false;
    let resultTimer = 0;

    /* ── Lecture du formulaire ── */
    // Valeurs de repli si un champ est vidé pendant la saisie.
    const base = defaultInput();

    function read(): CalcInput {
      const activity =
        form!.querySelector<HTMLInputElement>('[name="activity"]:checked')?.value === "ecommerce"
          ? "ecommerce"
          : "leadgen";
      const sectorId = field<HTMLSelectElement>("sector")?.value ?? base.sector;
      const sector = getSector(sectorId);
      const recurring = form!.querySelector<HTMLInputElement>('[name="recurring"]:checked')?.value === "1";

      return {
        activity,
        sector: sector.id,
        clients: num("clients", base.clients),
        // Facultatif : vide (donc 0) signifie « pas de contrôle de rentabilité ».
        clientValue: num("clientValue", 0),
        recurring: expert && recurring,
        purchasesPerYear: num("purchasesPerYear", base.purchasesPerYear),
        loyaltyYears: num("loyaltyYears", base.loyaltyYears),
        basket: num("basket", base.basket),
        margePct: num("margePct", base.margePct),
        orders: num("orders", base.orders),
        // La zone n'existe plus qu'en mode expert : sinon, pas de majoration.
        urban: expert && field<HTMLSelectElement>("urban")?.value === "1",
        cpcMin: expert ? num("cpcMin", sector.cpcMin) : sector.cpcMin,
        cpcMax: expert ? num("cpcMax", sector.cpcMax) : sector.cpcMax,
        conv: expert ? num("conv", sector.conv * 100) / 100 : sector.conv,
        closing: expert ? num("closing", sector.closing * 100) / 100 : sector.closing,
        // La marge du secteur s'applique aussi en mode simple : la rentabilité
        // se juge sur la marge, pas sur le chiffre d'affaires.
        marge: expert ? num("marge", sector.marge * 100) / 100 : sector.marge,
        safety: expert ? num("safety", base.safety) : base.safety,
        roasOverride: expert && roasTouched ? num("roasOverride", 0) : 0,
        repeatRate: expert ? num("repeatRate", 0) / 100 : 0,
      };
    }

    /* ── Animation des chiffres (respecte prefers-reduced-motion) ── */
    const animations = new WeakMap<HTMLElement, number>();
    function setNumber(el: HTMLElement | null, value: number) {
      if (!el) return;
      const from = Number(el.dataset.raw ?? value);
      el.dataset.raw = String(value);
      const previous = animations.get(el);
      if (previous) cancelAnimationFrame(previous);
      if (reduceMotion || from === value) {
        el.textContent = fmt(value);
        return;
      }
      const start = performance.now();
      const duration = 320;
      const step = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = fmt(from + (value - from) * eased);
        if (t < 1) animations.set(el, requestAnimationFrame(step));
      };
      animations.set(el, requestAnimationFrame(step));
    }

    /* ── Visibilité des blocs selon le modèle et le mode expert ── */
    function syncVisibility() {
      root.querySelectorAll<HTMLElement>("[data-when]").forEach((el) => {
        const when = el.dataset.when;
        const show =
          when === "recurring"
            ? expert && state.recurring
            : when === "expert-only"
              ? expert
              : when === state.activity;
        el.toggleAttribute("hidden", !show);
      });
      const panel = root.querySelector<HTMLElement>("[data-expert]");
      panel?.toggleAttribute("hidden", !expert);
      const toggle = root.querySelector<HTMLButtonElement>("[data-expert-toggle]");
      toggle?.setAttribute("aria-expanded", String(expert));
      setText("expert-label", expert ? "Masquer le mode expert" : "Mode expert");
      setText(
        "eyebrow",
        state.activity === "ecommerce"
          ? "Budget publicitaire à prévoir"
          : "Budget publicitaire recommandé",
      );

      // En mode récurrent, le champ « valeur client » devient la valeur par achat.
      const valueLabel = out("value-label");
      const valueTip = out("value-tip");
      if (valueLabel?.firstChild) {
        valueLabel.firstChild.textContent = state.recurring
          ? "Valeur moyenne par achat ou mission (CHF) "
          : "Valeur d'un nouveau client (CHF) ";
      }
      if (valueTip) {
        valueTip.textContent = state.recurring
          ? "Ce qu'un client dépense à chaque visite ou mandat. Exemples : un patient de cabinet dentaire, un mandat annuel de fiduciaire, une visite en institut de beauté."
          : "Ce qu'un client typique vous rapporte en chiffre d'affaires. Pour un client récurrent, comptez la première année.";
      }
    }

    /* ── Rendu ── */
    function render() {
      state = read();
      const r = compute(state);
      const copy = resultCopy(state, r);

      syncVisibility();

      setNumber(out("reco"), r.budgetReco);
      setText("band", copy.band);
      // Une ligne vide est une ligne masquée : évite les blancs dans le bloc.
      const line = (key: string, value: string, row?: string) => {
        setText(key, value);
        const el = row
          ? root.querySelector<HTMLElement>(`[data-row="${row}"]`)
          : out(key);
        el?.toggleAttribute("hidden", !value);
      };
      // En expert côté leads, le bloc chiffré donne la projection exacte : garder
      // en plus la fourchette du secteur remettrait deux chiffres pour la même
      // notion, ce qui était précisément la source de confusion.
      line("anchor", expert && state.activity === "leadgen" ? "" : copy.anchor);
      line("cost-value", copy.costValue, "cost");
      setText("cost-label", copy.costLabel);
      line("cost-allin", copy.costAllIn);
      line("revenue-value", copy.revenueValue, "revenue");
      line("roi-value", copy.roiValue, "roi");
      line("marge-line", copy.margeLine);
      setText("source", copy.source);

      const msg = root.querySelector<HTMLElement>("[data-msg]");
      if (msg) {
        msg.textContent = copy.message;
        msg.dataset.tone = copy.tone;
        msg.toggleAttribute("hidden", copy.tone === "none");
      }

      const pack = root.querySelector<HTMLElement>("[data-pack]");
      const tier = r.tier ? tiers.find((t) => t.id === r.tier!.id) : null;
      pack?.toggleAttribute("hidden", !tier);
      if (tier) {
        setText("pack-name", tier.name);
        setText("pack-price", `${tier.price}${tier.unit}`);
        setText("pack-line", copy.packLine);
        const cta = root.querySelector<HTMLAnchorElement>("[data-pack-cta]");
        if (cta) {
          cta.href = tier.stripeLink || `/contact?pack=${tier.id}`;
          cta.innerHTML = `${tier.ctaLabel}<span class="arrow" aria-hidden="true">→</span>`;
        }
        const overflow = out("pack-overflow");
        if (overflow) {
          overflow.textContent = copy.packOverflow;
          overflow.toggleAttribute("hidden", !copy.packOverflow);
        }
      }

      // Valeurs affichées des sliders et lignes pédagogiques.
      setText("clients-val", String(Math.round(state.clients)));
      setText("loyalty-val", String(Math.round(state.loyaltyYears)));
      setText("ltv", `${fmt(r.ltv)} CHF`);
      setText(
        "roas-hint",
        `Avec une marge de ${fmt(state.margePct)}%, chaque franc de publicité doit générer au moins ${fmtDec(100 / state.margePct)} francs de ventes pour rentrer dans vos frais.`,
      );
      setText("revenue-hint", `Soit ${fmt(r.revenue)} CHF de ventes supplémentaires par mois.`);
      setText(
        "roas-override-val",
        roasTouched ? `${fmtDec(r.roasTarget)} (imposé)` : `${fmtDec(r.roasTarget)} (déduit de la marge)`,
      );
      setText("expert-cpa", cpaLine(r));
      setText("assumptions", assumptionsCopy(state, r));
      setText("live", copy.live);

      // Analytics : un seul calc_result par salve de réglages.
      window.clearTimeout(resultTimer);
      resultTimer = window.setTimeout(() => {
        track("calc_result", {
          calc_activity: state.activity,
          calc_sector: state.activity === "leadgen" ? state.sector : "ecommerce",
          calc_budget: r.budgetReco,
          calc_budget_low: r.budgetLow,
          calc_budget_high: r.budgetHigh,
          calc_pack: r.tier?.id ?? "none",
          calc_expert: expert,
        });
        if (r.status === "floor") track("calc_floor_hit", { calc_sector: state.sector });
        if (r.status === "lowMargin") track("calc_low_margin", { calc_marge: state.margePct });
      }, 700);
    }

    /** Recopie les hypothèses du secteur dans les champs experts. */
    function syncExpertInputs() {
      const s = getSector(state.sector);
      const set = (name: string, value: string) => {
        const el = field<HTMLInputElement>(name);
        if (el) el.value = value;
      };
      // Le coût du clic affiché intègre la majoration de zone : c'est bien lui
      // que la concurrence des agglomérations fait monter, pas le budget final.
      const cpc = zoneCpc(s, field<HTMLSelectElement>("urban")?.value === "1");
      set("cpcMin", String(cpc.min));
      set("cpcMax", String(cpc.max));
      set("conv", String(Math.round(s.conv * 1000) / 10));
      set("closing", String(Math.round(s.closing * 100)));
      set("marge", String(Math.round(s.marge * 100)));
      syncRoas();
    }

    /** Recopie la valeur entre le champ chiffré et le curseur d'un même réglage. */
    function syncPair(boxName: string, rangeName: string, min: number, max: number, from: string) {
      const box = field<HTMLInputElement>(boxName);
      const range = field<HTMLInputElement>(rangeName);
      if (!box || !range) return;
      if (from === rangeName) box.value = range.value;
      else if (box.value !== "") {
        range.value = String(Math.min(Math.max(Number(box.value) || min, min), max));
      }
    }

    /** Recale le curseur ROAS sur la valeur déduite de la marge et du réachat. */
    function syncRoas() {
      const el = field<HTMLInputElement>("roasOverride");
      if (!el) return;
      const margePct = num("margePct", defaultInput().margePct);
      const repeat = 1 + (expert ? num("repeatRate", 0) / 100 : 0);
      el.value = String(Math.round((100 / margePct / repeat) * 10) / 10);
    }

    /* ── Écoute ── */
    form.addEventListener("input", (e) => {
      if (!started) {
        started = true;
        track("calc_start");
      }
      const target = e.target as HTMLElement;
      // Changer de secteur réapplique ses hypothèses (CPC, taux, marge).
      if (target instanceof HTMLSelectElement && target.name === "sector") {
        state = applySector(state, target.value);
        syncExpertInputs();
      }
      // Changer de zone recalcule le coût du clic, donc les champs experts.
      if (target instanceof HTMLSelectElement && target.name === "urban") syncExpertInputs();
      if (target instanceof HTMLInputElement) {
        // Champ chiffré et curseur pilotent la même valeur : on recopie l'un
        // dans l'autre. Le champ libre peut recevoir n'importe quoi, on le
        // borne donc sur la plage du curseur avant de recopier.
        if (target.name === "margePct" || target.name === "margePctRange") {
          syncPair("margePct", "margePctRange", params.margePctMin, params.margePctMax, target.name);
          // La marge vient de changer : le ROAS redevient celui qu'elle impose.
          roasTouched = false;
          syncRoas();
        }
        if (target.name === "orders" || target.name === "ordersRange") {
          syncPair("orders", "ordersRange", params.ordersMin, params.ordersMax, target.name);
        }
        // Le réachat change lui aussi le ROAS exigé : même recalage.
        if (target.name === "repeatRate") {
          roasTouched = false;
          syncRoas();
        }
        if (target.name === "roasOverride") roasTouched = true;
      }
      render();
    });
    form.addEventListener("change", () => render());

    root.querySelector<HTMLButtonElement>("[data-expert-toggle]")?.addEventListener("click", () => {
      expert = !expert;
      if (expert) syncExpertInputs();
      render();
    });

    root.querySelector<HTMLButtonElement>("[data-reset]")?.addEventListener("click", () => {
      syncExpertInputs();
      const safety = field<HTMLInputElement>("safety");
      if (safety) safety.value = String(defaultInput().safety);
      render();
    });

    root.querySelector<HTMLElement>("[data-pack]")?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-pack-cta]")) {
        track("calc_pack_click", { calc_pack: compute(state).tier?.id ?? "none" });
      }
    });

    // Mode expert via ?pro=1 (outil de vente, non indexé : la page pose son canonique sans paramètre).
    if (new URLSearchParams(location.search).get("pro") === "1") {
      expert = true;
      syncExpertInputs();
    }

    render();
  });
</script>
