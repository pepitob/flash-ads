---
/**
 * Grille tarifaire (4 packs) - lit src/data/tarifs.ts (source unique).
 * Pack Croissance mis en avant (badge « Le plus choisi »).
 * Prix fixes et publics : CTA « Choisir [pack] » → /contact?pack=<id>
 * (pré-sélection du budget dans le formulaire). Seul « Sur mesure » invite
 * à l'échange. Un lien Stripe configuré remplace le lien contact.
 */
import AddOnsTable from "./AddOnsTable.astro";
import { tiers, pricingNotes, specialCampaignsNote } from "../data/tarifs";
---

<div class="price-grid">
  {
    tiers.map((tier) => (
      <div class:list={["price", { feat: tier.featured }]}>
        {tier.badge && <span class="badge">{tier.badge}</span>}
        <span class="tier">{tier.name}</span>
        <div class="amt">{tier.price}<small> {tier.unit}</small></div>
        <div class="for">{tier.forBudget}</div>
        <div class="rows">
          {tier.attributes.map((a) => (
            <div class="row">
              <span class="k">
                {a.label}
                {a.footnote && <sup title={specialCampaignsNote}>*</sup>}
              </span>
              <span class="v">{a.value}</span>
            </div>
          ))}
        </div>
        <div class="price-cta">
          <a
            href={tier.stripeLink || `/contact?pack=${tier.id}`}
            class:list={["btn", tier.featured ? "btn-primary" : "btn-ghost"]}
            rel={tier.stripeLink ? "nofollow" : undefined}
          >
            {tier.ctaLabel}
          </a>
        </div>
      </div>
    ))
  }
</div>

<p class="price-footnote">* Campagnes spéciales : {specialCampaignsNote}</p>
<p class="price-sub"><b>{pricingNotes.budgetSeparate}</b> {pricingNotes.vat}</p>

<AddOnsTable />

<style>
  .price-cta { margin-top: auto; padding-top: 20px; }
  .price-cta .btn { justify-content: center; width: 100%; }
  .price-footnote,
  .price-sub {
    font-size: 12.5px;
    color: var(--muted-on, var(--muted));
    text-align: center;
    margin-top: 14px;
    max-width: 52em;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .price-sub { margin-top: 8px; }
  .price-sub b { color: var(--on, var(--body)); font-weight: 500; }
</style>
