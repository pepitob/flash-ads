# ──────────────────────────────────────────────────────────────
# Formulaires - endpoints Formspree (host-agnostic).
# Créez deux formulaires sur https://formspree.io et collez les IDs ci-dessous.
# Copiez ce fichier en `.env` (non commité). Préfixe PUBLIC_ = exposé au client.
# ──────────────────────────────────────────────────────────────

# Formulaire de demande de devis (/contact)
PUBLIC_FORMSPREE_QUOTE_ID=

# Formulaire liste d'attente ChatGPT Ads (/services/chatgpt-ads)
PUBLIC_FORMSPREE_WAITLIST_ID=
