# ──────────────────────────────────────────────────────────────
# Formulaires.
# Copiez ce fichier en `.env` (non commité). Préfixe PUBLIC_ = exposé au client.
#
# Le formulaire de devis (/contact) passe par Netlify Forms : aucune variable
# n'est nécessaire, mais « Forms > Enable form detection » doit être activé sur
# le site Netlify avant le déploiement.
# ──────────────────────────────────────────────────────────────

# Formulaire liste d'attente ChatGPT Ads (/services/chatgpt-ads) - Formspree
PUBLIC_FORMSPREE_WAITLIST_ID=
